@page
@model eGestion360Web.Pages.SinAccesoModel
@{
    ViewData["Title"] = "Acceso limitado";
}

<div class="container">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="/MainMenu">Menú Principal</a></li>
            <li class="breadcrumb-item active">Acceso limitado</li>
        </ol>
    </nav>

    @if (Model.SoloLectura)
    {
        <div class="alert alert-warning">
            <h5 class="alert-heading mb-2"><i class="fas fa-eye me-2"></i>Tu cuenta está en solo lectura</h5>
            <p class="mb-2">
                @Model.NombreDelTenant está suspendido. Puedes consultar tus datos, pero no se guardan cambios mientras dure la suspensión.
                El cambio que intentaste no se guardó.
            </p>
            @if (!string.IsNullOrWhiteSpace(Model.Motivo))
            {
                <p class="mb-2"><strong>Motivo:</strong> @Model.Motivo</p>
            }
            <p class="mb-0">Si crees que es un error, comunícate con quien administra tu cuenta.</p>
        </div>
        <a asp-page="/MainMenu" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-2"></i>Volver al menú</a>
    }
    else if (Model.Bloqueado)
    {
        <div class="alert alert-danger">
            <h5 class="alert-heading mb-2"><i class="fas fa-ban me-2"></i>Tu cuenta no puede usar el sistema por ahora</h5>
            <p class="mb-2">@Model.NombreDelTenant está @Model.EstadoEnPalabras y no tiene acceso a sus pantallas.</p>
            @if (!string.IsNullOrWhiteSpace(Model.Motivo))
            {
                <p class="mb-2"><strong>Motivo:</strong> @Model.Motivo</p>
            }
            <p class="mb-0">Comunícate con quien administra tu cuenta para reactivarla.</p>
        </div>
        <a asp-page="/Logout" class="btn btn-outline-secondary"><i class="fas fa-sign-out-alt me-2"></i>Cerrar sesión</a>
    }
    else
    {
        <div class="alert alert-info">
            <h5 class="alert-heading mb-2"><i class="fas fa-circle-info me-2"></i>No hay nada que explicar</h5>
            <p class="mb-0">Tu cuenta funciona con normalidad.</p>
        </div>
        <a asp-page="/MainMenu" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-2"></i>Volver al menú</a>
    }
</div>
