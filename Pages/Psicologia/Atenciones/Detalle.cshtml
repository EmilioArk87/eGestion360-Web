@page "{id:int}"
@model eGestion360Web.Pages.Psicologia.Atenciones.DetalleModel
@using eGestion360Web.Models.Psicologia
@{
    ViewData["Title"] = "Evaluación " + Model.Atencion.FechaAtencion.ToString("dd/MM/yyyy") + " · " + Model.Expediente;
    var a = Model.Atencion;
    var estadoClase = a.Estado == EstadosAtencion.Borrador ? "bg-warning text-dark" : a.Estado == EstadosAtencion.Cerrada ? "bg-success" : "bg-secondary";
    var estadoTexto = a.Estado == EstadosAtencion.Borrador ? "En borrador" : a.Estado == EstadosAtencion.Cerrada ? "Cerrada" : "Anulada";
    string TextoConclusion(string? c) => c == ResultadosConstancia.Apto ? "Apto" : c == ResultadosConstancia.NoApto ? "No apto" : "Sin definir";
    var vigentes = Model.Constancias.Count(c => c.Estado == EstadosConstancia.Emitida);
    var hayConstanciaVigente = vigentes > 0;
}

<div class="container">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="/MainMenu">Menú Principal</a></li>
            <li class="breadcrumb-item"><a asp-page="/Psicologia/Index">Psicología</a></li>
            <li class="breadcrumb-item"><a asp-page="/Psicologia/Pacientes/Index">Pacientes</a></li>
            <li class="breadcrumb-item"><a asp-page="/Psicologia/Pacientes/Detalle" asp-route-id="@Model.IdPaciente">@Model.Expediente</a></li>
            <li class="breadcrumb-item active" aria-current="page">Evaluación del @a.FechaAtencion.ToString("dd/MM/yyyy")</li>
        </ol>
    </nav>

    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-4">
        <div>
            <h2 class="mb-1"><i class="fas fa-notes-medical me-2"></i>Evaluación psicológica</h2>
            <p class="text-muted mb-0">
                <strong>@Model.Paciente</strong> · expediente <span class="font-monospace">@Model.Expediente</span>
                · @a.FechaAtencion.ToString("dd/MM/yyyy") · @(Model.Jornada ?? "Consulta")
            </p>
            <p class="small text-muted mb-0">
                @(a.EdadDeclarada != null ? a.EdadDeclarada + " años" : "Sin edad registrada")
                · @(a.NombreProfesional ?? "Sin profesional asignado")
            </p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <span class="badge @estadoClase fs-6">@estadoTexto</span>
            <a asp-page="/Psicologia/Pacientes/Detalle" asp-route-id="@Model.IdPaciente" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-2"></i>Expediente</a>
        </div>
    </div>

    @if (TempData["AtencionMensaje"] is string mensaje)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@mensaje
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }
    @if (TempData["AtencionError"] is string error)
    {
        <div class="alert alert-danger" role="alert"><i class="fas fa-times-circle me-2"></i>@error</div>
    }

    @if (a.Estado == EstadosAtencion.Cerrada)
    {
        <div class="alert alert-light border small">
            <i class="fas fa-lock me-1"></i>Cerrada el @a.FechaCierre!.Value.AddHours(-6).ToString("dd/MM/yyyy HH:mm") por @a.CerradoPor. Ya no se puede cambiar.
        </div>
    }
    else if (a.Estado == EstadosAtencion.Anulada)
    {
        <div class="alert alert-secondary small"><i class="fas fa-ban me-1"></i>Anulada: @a.MotivoAnulacion</div>
    }

    <div class="row g-4">
        <div class="col-lg-8">
            @if (Model.Editable)
            {
                <form method="post" asp-page-handler="Guardar" asp-route-id="@a.IdAtencion" id="form-evaluacion" class="card border-0 shadow-sm" novalidate>
                    <div class="card-body">
                        <div asp-validation-summary="All" class="alert alert-danger py-2 small mb-3" role="alert"></div>

                        <h5 class="mb-1">Pruebas aplicadas y su resultado</h5>
                        <p class="small text-muted mb-2">Marca cada prueba que se aplicó y anota su resultado: puntaje, rango o interpretación breve.</p>
                        @if (Model.Pruebas.Count == 0)
                        {
                            <div class="alert alert-light border small mb-3">
                                El catálogo de pruebas está vacío. <a asp-page="/Psicologia/Catalogos/Index">Agrega las pruebas que aplica el centro.</a>
                            </div>
                        }
                        else
                        {
                            <div class="table-responsive mb-3">
                                <table class="table table-sm align-middle mb-0">
                                    <thead class="table-light">
                                        <tr><th style="width:2.5rem;"><span class="visually-hidden">Aplicada</span></th><th>Prueba</th><th style="width:45%;">Resultado</th></tr>
                                    </thead>
                                    <tbody>
                                        @for (var i = 0; i < Model.Pruebas.Count; i++)
                                        {
                                            var p = Model.Pruebas[i];
                                            var fila = Model.Input.Pruebas.FirstOrDefault(x => x.IdPrueba == p.Id);
                                            <tr>
                                                <td>
                                                    <input type="hidden" name="Input.Pruebas[@i].IdPrueba" value="@p.Id" />
                                                    <input class="form-check-input js-aplicada" type="checkbox" name="Input.Pruebas[@i].Aplicada" value="true" id="aplicada-@p.Id"
                                                           @(fila?.Aplicada == true ? "checked" : "") />
                                                </td>
                                                <td>
                                                    <label class="form-check-label" for="aplicada-@p.Id"><span class="font-monospace fw-semibold">@p.Codigo</span> · @p.Nombre</label>
                                                    @if (!p.Activa) { <span class="badge bg-light text-muted border ms-1">ya no está en el catálogo</span> }
                                                </td>
                                                <td>
                                                    <input type="text" class="form-control form-control-sm js-resultado" name="Input.Pruebas[@i].Resultado" value="@fila?.Resultado"
                                                           maxlength="200" data-prueba="@p.Id" aria-label="Resultado de @p.Codigo" placeholder="Por ejemplo: 42 puntos, dentro de lo normal" />
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }

                        <h5 class="mb-2">Conclusión</h5>
                        <div class="d-flex flex-wrap gap-3 mb-3" role="radiogroup" aria-label="Conclusión">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="Input.Conclusion" id="conclusion-apto" value="@ResultadosConstancia.Apto" @(Model.Input.Conclusion == ResultadosConstancia.Apto ? "checked" : "") />
                                <label class="form-check-label" for="conclusion-apto"><span class="badge bg-success">Apto</span></label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="Input.Conclusion" id="conclusion-noapto" value="@ResultadosConstancia.NoApto" @(Model.Input.Conclusion == ResultadosConstancia.NoApto ? "checked" : "") />
                                <label class="form-check-label" for="conclusion-noapto"><span class="badge bg-danger">No apto</span></label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="Input.Conclusion" id="conclusion-pendiente" value="" @(Model.Input.Conclusion == null ? "checked" : "") />
                                <label class="form-check-label text-muted" for="conclusion-pendiente">Todavía sin definir</label>
                            </div>
                        </div>

                        <label asp-for="Input.Observaciones" class="form-label h5 mb-2">Observaciones</label>
                        <textarea asp-for="Input.Observaciones" class="form-control" rows="4" maxlength="4000"></textarea>
                        <span asp-validation-for="Input.Observaciones" class="text-danger small"></span>
                    </div>
                    <div class="card-footer bg-white d-flex flex-wrap justify-content-end gap-2">
                        <button type="submit" class="btn btn-primary"><i class="fas fa-save me-1"></i>Guardar</button>
                        @if (Model.PuedeCerrar)
                        {
                            <a class="btn btn-outline-success" data-bs-toggle="collapse" href="#confirmar-cierre" role="button" aria-expanded="false" aria-controls="confirmar-cierre">
                                <i class="fas fa-lock me-1"></i>Guardar y cerrar…
                            </a>
                        }
                    </div>
                    @if (Model.PuedeCerrar)
                    {
                        <div class="collapse" id="confirmar-cierre">
                            <div class="border-top border-success p-3 bg-light">
                                <p class="small mb-2">
                                    Al cerrar, la evaluación ya no se puede cambiar. Hace falta el resultado de cada prueba aplicada y la conclusión.
                                </p>
                                <button type="submit" class="btn btn-success" asp-page-handler="Cerrar" asp-route-id="@a.IdAtencion">
                                    <i class="fas fa-lock me-1"></i>Sí, guardar y cerrar
                                </button>
                            </div>
                        </div>
                    }
                </form>
            }
            else
            {
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <h5 class="mb-2">Pruebas aplicadas y su resultado</h5>
                        @if (Model.Aplicadas.Count == 0)
                        {
                            <p class="text-muted fst-italic">Ninguna prueba registrada.</p>
                        }
                        else
                        {
                            <table class="table table-sm mb-3">
                                <tbody>
                                    @foreach (var (p, resultado) in Model.Aplicadas)
                                    {
                                        <tr>
                                            <td style="width:45%;"><span class="font-monospace fw-semibold">@p.Codigo</span> · @p.Nombre</td>
                                            <td>@(resultado ?? "—")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }

                        <h5 class="mb-2">Conclusión</h5>
                        <p>
                            <span class="badge @(a.Conclusion == ResultadosConstancia.Apto ? "bg-success" : a.Conclusion == ResultadosConstancia.NoApto ? "bg-danger" : "bg-light text-muted border")">@TextoConclusion(a.Conclusion)</span>
                        </p>

                        <h5 class="mb-2">Observaciones</h5>
                        <p class="mb-0" style="white-space: pre-wrap;">@(a.Observaciones ?? "—")</p>
                    </div>
                    @if (Model.EnBorrador && Model.PuedeCerrar)
                    {
                        <div class="card-footer bg-white text-end">
                            <form method="post" asp-page-handler="Cerrar" asp-route-id="@a.IdAtencion" class="d-inline">
                                <button type="submit" class="btn btn-success"><i class="fas fa-lock me-1"></i>Cerrar la evaluación</button>
                            </form>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="col-lg-4">
            @if (Model.PuedeVerConstancias)
            {
                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-body">
                        <h6 class="card-title"><i class="fas fa-file-signature me-2"></i>Constancias de esta evaluación</h6>
                        @if (Model.Constancias.Count == 0)
                        {
                            <p class="small text-muted mb-2">Todavía no se emitió ninguna.</p>
                        }
                        else
                        {
                            <ul class="list-unstyled small mb-2">
                                @foreach (var c in Model.Constancias)
                                {
                                    var anulada = c.Estado == EstadosConstancia.Anulada;
                                    <li class="@(anulada ? "text-muted" : "")">
                                        <span class="font-monospace @(anulada ? "text-decoration-line-through" : "fw-semibold")">@c.Numero</span> · @c.Tipo
                                        @if (anulada) { <span class="badge bg-secondary ms-1">anulada</span> }
                                    </li>
                                }
                            </ul>
                        }
                        @if (Model.PuedeEmitir && a.Estado != EstadosAtencion.Anulada)
                        {
                            <a asp-page="/Psicologia/Constancias/Emitir" asp-route-idPaciente="@Model.IdPaciente" asp-route-idAtencion="@a.IdAtencion" class="btn btn-sm btn-success">
                                <i class="fas fa-plus me-1"></i>Emitir constancia
                            </a>
                        }
                    </div>
                </div>
            }

            @if (Model.PuedeAnular && a.Estado != EstadosAtencion.Anulada)
            {
                <div class="card border-0 shadow-sm">
                    <div class="card-body">
                        <h6 class="card-title text-danger"><i class="fas fa-ban me-2"></i>Anular la evaluación</h6>
                        @if (hayConstanciaVigente)
                        {
                            <p class="small text-muted mb-0">
                                @(vigentes == 1 ? "De esta evaluación salió una constancia vigente: anúlala primero desde el expediente."
                                                : $"De esta evaluación salieron {vigentes} constancias vigentes: anúlalas primero desde el expediente.")
                            </p>
                        }
                        else
                        {
                            <form method="post" asp-page-handler="Anular" asp-route-id="@a.IdAtencion">
                                <label class="form-label small mb-1" for="motivo">Motivo</label>
                                <input type="text" class="form-control form-control-sm mb-2" id="motivo" name="motivo" maxlength="300" required placeholder="Por ejemplo: se registró en el paciente equivocado" />
                                <button type="submit" class="btn btn-sm btn-outline-danger">Anular</button>
                                <div class="form-text">Queda en el expediente como anulada, con su motivo.</div>
                            </form>
                        }
                    </div>
                </div>
            }

            <div class="alert alert-light border small mt-3 mb-0">
                <i class="fas fa-lock me-1"></i>Datos de salud confidenciales. Las observaciones y los resultados no se copian a la bitácora de cambios.
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            // Al escribir un resultado, la prueba queda marcada como aplicada.
            document.querySelectorAll('.js-resultado').forEach(caja => caja.addEventListener('input', () => {
                const marca = document.getElementById('aplicada-' + caja.dataset.prueba);
                if (marca && caja.value.trim() !== '') marca.checked = true;
            }));
        })();
    </script>
}
