@page
@model eGestion360Web.Pages.Psicologia.Constancias.EmitirModel
@{
    ViewData["Title"] = "Emitir constancia";
    var sinCatalogos = Model.Tipos.Count == 0 || Model.Catalogo.Count == 0;
}

<div class="container">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="/MainMenu">Menú Principal</a></li>
            <li class="breadcrumb-item"><a asp-page="/Psicologia/Index">Psicología</a></li>
            <li class="breadcrumb-item"><a asp-page="/Psicologia/Pacientes/Index">Pacientes</a></li>
            <li class="breadcrumb-item"><a asp-page="/Psicologia/Pacientes/Detalle" asp-route-id="@Model.IdPaciente">@Model.Expediente</a></li>
            <li class="breadcrumb-item active" aria-current="page">Emitir constancia</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <h2 class="mb-1"><i class="fas fa-file-signature me-2"></i>Emitir constancia</h2>
            <p class="text-muted mb-0">Constancia de examen psicológico para <strong>@Model.Nombre</strong> · expediente <span class="font-monospace">@Model.Expediente</span></p>
        </div>
        <a asp-page="/Psicologia/Pacientes/Detalle" asp-route-id="@Model.IdPaciente" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-2"></i>Volver</a>
    </div>

    @if (sinCatalogos)
    {
        <div class="alert alert-warning">
            <i class="fas fa-exclamation-triangle me-2"></i>
            Para emitir hace falta al menos un tipo de constancia y una prueba psicológica activos en el catálogo.
            <a asp-page="/Psicologia/Catalogos/Index" class="alert-link">Ir a Catálogos</a>
        </div>
    }
    else
    {
        <form method="post" asp-route-idPaciente="@Model.IdPaciente" class="card border-0 shadow-sm" novalidate>
            <div class="card-body">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3" role="alert"></div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="Input.IdTipoConstancia" class="form-label">Tipo de constancia <span class="text-danger">*</span></label>
                        <select asp-for="Input.IdTipoConstancia" class="form-select">
                            <option value="">Elige…</option>
                            @foreach (var t in Model.Tipos) { <option value="@t.Id">@t.Texto</option> }
                        </select>
                        <span asp-validation-for="Input.IdTipoConstancia" class="text-danger small"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Input.FechaEmision" class="form-label">Fecha de emisión <span class="text-danger">*</span></label>
                        <input asp-for="Input.FechaEmision" type="date" class="form-control"
                               min="@Model.RangoElegido.Desde.ToString("yyyy-MM-dd")" max="@Model.RangoElegido.Hasta.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="Input.FechaEmision" class="text-danger small"></span>
                        <div class="form-text" id="fecha-rango">Puede ir @Model.RangoElegido.Texto.</div>
                    </div>
                    <div class="col-md-3">
                        @{ var conTalonario = Model.TipoElegido?.Talonario == true; }
                        <div id="numero-correlativo" @(conTalonario ? "hidden" : "")>
                            <label class="form-label" for="numero-propuesto">Número</label>
                            <input type="text" id="numero-propuesto" class="form-control font-monospace" value="@(conTalonario ? "" : Model.NumeroDelTipoElegido)" placeholder="Elige el tipo" readonly />
                            <div class="form-text">Correlativo del tipo. Se confirma al guardar.</div>
                        </div>
                        <div id="numero-folio" @(conTalonario ? "" : "hidden")>
                            <label asp-for="Input.Folio" class="form-label">Folio de la hoja</label>
                            <input asp-for="Input.Folio" type="number" min="1" class="form-control font-monospace" placeholder="@(conTalonario ? Model.NumeroDelTipoElegido : "")" disabled="@(!conTalonario)" />
                            <span asp-validation-for="Input.Folio" class="text-danger small"></span>
                            <div class="form-text">El número impreso en la hoja del talonario. Vacío: el siguiente libre.</div>
                        </div>
                    </div>
                </div>

                @{ var conResultado = Model.TipoElegido?.PideResultado == true; }
                <fieldset class="mb-3" id="bloque-resultado" @(conResultado ? "" : "hidden")>
                    <legend class="form-label fs-6 mb-1">Resultado <span class="text-danger">*</span></legend>
                    <div class="d-flex gap-4">
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="Input.Resultado" id="resultado-apto" value="@eGestion360Web.Models.Psicologia.ResultadosConstancia.Apto"
                                   @(Model.Input.Resultado == eGestion360Web.Models.Psicologia.ResultadosConstancia.Apto ? "checked" : "") />
                            <label class="form-check-label" for="resultado-apto">Apto</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="Input.Resultado" id="resultado-no-apto" value="@eGestion360Web.Models.Psicologia.ResultadosConstancia.NoApto"
                                   @(Model.Input.Resultado == eGestion360Web.Models.Psicologia.ResultadosConstancia.NoApto ? "checked" : "") />
                            <label class="form-check-label" for="resultado-no-apto">No apto</label>
                        </div>
                    </div>
                    <span asp-validation-for="Input.Resultado" class="text-danger small"></span>
                </fieldset>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label asp-for="Input.IdAtencion" class="form-label">Evaluación de la que sale</label>
                        <select asp-for="Input.IdAtencion" class="form-select">
                            <option value="">Ninguna</option>
                            @foreach (var a in Model.Atenciones) { <option value="@a.Id">@a.Texto</option> }
                        </select>
                        <span asp-validation-for="Input.IdAtencion" class="text-danger small"></span>
                        <div class="form-text">Al elegirla se proponen sus pruebas aplicadas y su profesional.</div>
                    </div>
                    <div class="col-md-6">
                        @if (Model.Firmantes.Count > 0)
                        {
                            <label asp-for="Input.IdProfesional" class="form-label">Psicólogo que firma</label>
                            <select asp-for="Input.IdProfesional" class="form-select">
                                <option value="">Elige…</option>
                                @foreach (var f in Model.Firmantes) { <option value="@f.Id">@f.Texto</option> }
                            </select>
                            <span asp-validation-for="Input.IdProfesional" class="text-danger small"></span>
                            <div class="form-text">De <a asp-page="/Psicologia/Profesionales/Index">Profesionales</a>; sale con su título y colegiación.</div>
                        }
                        else
                        {
                            <label asp-for="Input.NombreProfesional" class="form-label">Profesional que firma</label>
                            <input asp-for="Input.NombreProfesional" class="form-control" placeholder="Nombre como saldrá impreso" autocomplete="off" />
                            <span asp-validation-for="Input.NombreProfesional" class="text-danger small"></span>
                            <div class="form-text">Registra a los psicólogos en <a asp-page="/Psicologia/Profesionales/Index">Profesionales</a> para elegirlos de una lista.</div>
                        }
                    </div>
                </div>

                <fieldset class="mb-2">
                    <legend class="form-label fs-6 mb-1">Prueba o pruebas psicológicas aplicadas <span class="text-danger">*</span></legend>
                    <div class="row row-cols-1 row-cols-md-2 g-1 border rounded p-2 bg-light">
                        @foreach (var p in Model.Catalogo)
                        {
                            <div class="col">
                                <div class="form-check">
                                    <input class="form-check-input js-prueba" type="checkbox" name="Input.Pruebas" value="@p.Id" id="prueba-@p.Id" @(Model.Input.Pruebas.Contains(p.Id) ? "checked" : "") />
                                    <label class="form-check-label small" for="prueba-@p.Id">@p.Texto</label>
                                </div>
                            </div>
                        }
                    </div>
                    <span asp-validation-for="Input.Pruebas" class="text-danger small"></span>
                </fieldset>

                <div class="alert alert-light border small mt-3 mb-3">
                    <i class="fas fa-info-circle me-1"></i>Una constancia emitida no se edita ni se borra: si tiene un error, se anula desde el expediente y se emite otra con el número siguiente.
                    Solo su fecha de emisión se puede corregir después, desde el expediente, dentro de las mismas fechas posibles.
                    Si la evaluación fue en una brigada, la fecha va dentro de los días de la brigada.
                </div>

                <div class="d-flex justify-content-end gap-2 border-top pt-3">
                    <a asp-page="/Psicologia/Pacientes/Detalle" asp-route-id="@Model.IdPaciente" class="btn btn-outline-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-success"><i class="fas fa-check me-2"></i>Emitir constancia</button>
                </div>
            </div>
        </form>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const atenciones = @Html.Raw(Model.AtencionesJson);
            const tipos = @Html.Raw(Model.TiposJson);
            const tipo = document.getElementById('Input_IdTipoConstancia');
            const numero = document.getElementById('numero-propuesto');
            const folio = document.getElementById('Input_Folio');
            const cajaCorrelativo = document.getElementById('numero-correlativo');
            const cajaFolio = document.getElementById('numero-folio');
            const cajaResultado = document.getElementById('bloque-resultado');
            if (tipo && numero && folio) tipo.addEventListener('change', () => {
                const t = tipos[tipo.value];
                const talonario = !!t && t.Talonario;
                cajaCorrelativo.hidden = talonario;
                cajaFolio.hidden = !talonario;
                folio.disabled = !talonario;
                folio.value = '';
                folio.placeholder = talonario ? (t.Siguiente || '') : '';
                numero.value = !talonario && t ? (t.Siguiente || '') : '';
                cajaResultado.hidden = !(t && t.PideResultado);
            });

            const select = document.getElementById('Input_IdAtencion');
            const profesional = document.getElementById('Input_NombreProfesional');
            const firmante = document.getElementById('Input_IdProfesional');
            const fecha = document.getElementById('Input_FechaEmision');
            const textoRango = document.getElementById('fecha-rango');
            const sinEvaluacion = @Html.Raw(Model.RangoSinEvaluacionJson);
            if (!select) return;
            select.addEventListener('change', () => {
                const a = atenciones[select.value];
                // El calendario solo deja las fechas posibles para esa evaluación; si la elegida queda afuera, se propone la última posible.
                const r = a ? a.Rango : sinEvaluacion;
                if (fecha && r) {
                    fecha.min = r.Desde;
                    fecha.max = r.Hasta;
                    if (!fecha.value || fecha.value < r.Desde || fecha.value > r.Hasta) fecha.value = r.Hasta;
                    if (textoRango) textoRango.textContent = 'Puede ir ' + r.Texto + '.';
                }
                document.querySelectorAll('.js-prueba').forEach(c => { c.checked = !!a && a.Pruebas.includes(Number(c.value)); });
                if (profesional && a && a.Profesional && !profesional.value) profesional.value = a.Profesional;
                if (firmante && a && a.IdProfesional) firmante.value = String(a.IdProfesional);
                if (a && a.Conclusion) {
                    const radio = document.querySelector('input[name="Input.Resultado"][value="' + a.Conclusion + '"]');
                    if (radio) radio.checked = true;
                }
            });
        })();
    </script>
}
