@page "{id:int}"
@model eGestion360Web.Pages.Psicologia.Constancias.ImprimirModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Constancia @Model.Numero</title>
    <style>
        /*
         * Hoja "Constancia de examen psicologico para solicitud de licencia de conducir" del Colegio de Psicologos de Honduras.
         * La hoja real mide 215 x 275 mm (medida el 2026-11-16), un poco menos que carta: se imprime en papel Carta y las posiciones van
         * en milimetros desde la esquina superior izquierda, asi que los 4.4 mm que le faltan quedan abajo, donde no se escribe nada.
         * La FECHA tiene las medidas reales (D15, 2026-11-16); el parrafo y las pruebas siguen PROVISIONALES, estimadas de la foto.
         */
        :root {
            --hoja-ancho: 215mm;
            --hoja-alto: 275mm;
            --letra: "Arial", "Helvetica", sans-serif;

            /* Renglon "__ de ________ del 20__": la base de los numeros a 35 mm del borde de arriba; cada blanco, de donde a donde va
               (el texto se centra en su blanco). */
            --fecha-base: 35mm;   /* medida: 40 mm; el 2026-11-17, a pedido de Emilio, subida un renglon (9 mm) y luego bajada 4 mm */
            --dia-desde: 14mm;   --dia-hasta: 25mm;
            --mes-desde: 33mm;   --mes-hasta: 68mm;
            --anio-desde: 80mm;  --anio-hasta: 92mm;   /* solo los dos ultimos digitos: el "20" ya viene impreso */

            --cuerpo-arriba: 74mm;      /* primer renglon del parrafo */
            --cuerpo-izquierda: 26mm;
            --cuerpo-ancho: 160mm;
            --cuerpo-renglon: 14mm;     /* distancia entre renglones de la hoja */

            --pruebas-arriba: 204mm;    /* renglon de "PRUEBAS PSICOLOGICAS APLICADAS:"; subido un renglon (9 mm) el 2026-11-16 a pedido de Emilio */
            --pruebas-izquierda: 13mm;
            --pruebas-ancho: 190mm;
            --pruebas-sangria: 98mm;    /* el texto empieza despues de la etiqueta impresa */
            --pruebas-renglon: 9mm;
        }

        @@page { size: letter; margin: 0; }
        * { box-sizing: border-box; }
        html, body { margin: 0; padding: 0; background: #e9ecef; font-family: var(--letra); color: #000; }

        .barra { position: sticky; top: 0; z-index: 2; background: #fff; border-bottom: 1px solid #ccc; padding: 10px 16px;
                 display: flex; flex-wrap: wrap; gap: 8px 16px; align-items: center; font-size: 14px; }
        .barra .dato { color: #444; }
        .barra .aviso { color: #8a5300; font-size: 12px; flex-basis: 100%; }
        .barra .error { color: #b00020; flex-basis: 100%; }
        .barra button, .barra a { font: inherit; padding: 6px 12px; border-radius: 6px; border: 1px solid #888; background: #f8f9fa; color: #000; text-decoration: none; cursor: pointer; }
        .barra .principal { background: #198754; border-color: #198754; color: #fff; }

        .hoja { position: relative; width: var(--hoja-ancho); height: var(--hoja-alto); margin: 16px auto; background: #fff;
                box-shadow: 0 0 0 1px #bbb; overflow: hidden; }
        /* Un dato de la fecha, centrado en su blanco y apoyado en la base del renglon. Con line-height 1, la base de la letra (Arial)
           queda a 0.81em de la parte de arriba de la caja (medido en el navegador): por eso la caja empieza 0.81em antes de --fecha-base. */
        .fecha { position: absolute; top: calc(var(--fecha-base) - 0.81em); font-size: 13pt; line-height: 1; white-space: nowrap;
                 text-align: center; }
        /* El cuerpo ("Por este medio se hace constar ... APTO para conducir."): 15 pt, dos puntos más que la fecha (pedido de Emilio, 2026-11-16). */
        .cuerpo { position: absolute; top: var(--cuerpo-arriba); left: var(--cuerpo-izquierda); width: var(--cuerpo-ancho);
                  font-size: 15pt; line-height: var(--cuerpo-renglon); }
        /* El nombre y el DNI no se cortan en dos renglones (pedido de Emilio, 2026-11-17). */
        .cuerpo .junto { white-space: nowrap; }
        .pruebas { position: absolute; top: var(--pruebas-arriba); left: var(--pruebas-izquierda); width: var(--pruebas-ancho);
                   font-size: 12pt; line-height: var(--pruebas-renglon); text-indent: var(--pruebas-sangria); }

        /* Guia: lo que ya viene impreso en la hoja del Colegio, para comparar posiciones (solo en la hoja de prueba). */
        .guia { position: absolute; color: #9aa0a6; font-size: 10pt; font-weight: bold; white-space: nowrap; }
        .renglon { position: absolute; left: 12mm; right: 12mm; border-bottom: 0.3mm dotted #c0c4c8; }
        .guia.fecha { font-size: 10pt; }
        .blanco { position: absolute; top: var(--fecha-base); border-top: 0.3mm solid #9aa0a6; }

        @@media print {
            html, body { background: #fff; }
            .barra { display: none; }
            .hoja { margin: 0; box-shadow: none; }
        }
    </style>
</head>
<body>
    <div class="barra">
        <strong>Constancia @Model.Numero</strong>
        <span class="dato">@Model.Paciente</span>
        @if (Model.Impedimento == null)
        {
            <form method="post" asp-page-handler="Registrar" asp-route-id="@Model.IdConstancia" style="display:inline">
                <button type="submit" class="principal">Imprimir en la hoja del Colegio</button>
            </form>
            @if (Model.Guia)
            {
                <a asp-page="Imprimir" asp-route-id="@Model.IdConstancia">Quitar la guía</a>
                <button type="button" onclick="window.print()">Imprimir hoja de prueba</button>
            }
            else
            {
                <a asp-page="Imprimir" asp-route-id="@Model.IdConstancia" asp-route-guia="true">Hoja de prueba (con guía)</a>
            }
        }
        <a asp-page="/Psicologia/Pacientes/Detalle" asp-route-id="@Model.IdPaciente">Volver al expediente</a>
        <span class="dato">Impresa @Model.Impresiones vez(ces)</span>
        @if (TempData["ImprimirError"] is string error) { <span class="error">@error</span> }
        @if (Model.Impedimento != null) { <span class="error">@Model.Impedimento</span> }
        else
        {
            <span class="aviso">En el cuadro de impresión: papel Carta, márgenes «Ninguno», escala 100 % y sin encabezados ni pies. La fecha ya va con las medidas reales de la hoja; el párrafo y las pruebas siguen en posiciones provisionales.
                @if (Model.Guia) { <text> La hoja de prueba no queda registrada: imprímela en papel blanco y compárala a contraluz con la hoja del Colegio.</text> }</span>
        }
    </div>

    @if (Model.Impedimento == null && Model.Texto != null)
    {
        var t = Model.Texto;
        <div class="hoja">
            @if (Model.Guia)
            {
                <div class="guia" style="top:12mm; left:40mm; font-size:14pt;">COLEGIO DE PSICÓLOGOS DE HONDURAS</div>
                <div class="blanco" style="left:var(--dia-desde); width:calc(var(--dia-hasta) - var(--dia-desde));"></div>
                <div class="guia fecha" style="left:var(--dia-hasta); width:calc(var(--mes-desde) - var(--dia-hasta));">de</div>
                <div class="blanco" style="left:var(--mes-desde); width:calc(var(--mes-hasta) - var(--mes-desde));"></div>
                <div class="guia fecha" style="left:var(--mes-hasta); width:calc(var(--anio-desde) - var(--mes-hasta));">del 20</div>
                <div class="blanco" style="left:var(--anio-desde); width:calc(var(--anio-hasta) - var(--anio-desde));"></div>
                <div class="guia" style="top:46mm; left:12mm;">CONSTANCIA DE EXAMEN PSICOLÓGICO PARA SOLICITUD DE LICENCIA DE CONDUCIR</div>
                @for (var i = 0; i < 4; i++)
                {
                    <div class="renglon" style="top:calc(var(--cuerpo-arriba) + @(i + 1) * var(--cuerpo-renglon) - 3mm);"></div>
                }
                <div class="guia" style="top:203mm; left:85mm;">VALOR L. 200.00</div>
                <div class="guia" style="top:var(--pruebas-arriba); left:var(--pruebas-izquierda);">PRUEBAS PSICOLÓGICAS APLICADAS:</div>
                <div class="renglon" style="top:calc(var(--pruebas-arriba) + var(--pruebas-renglon) - 2mm);"></div>
                <div class="renglon" style="top:calc(var(--pruebas-arriba) + 2 * var(--pruebas-renglon) - 2mm);"></div>
            }

            <div class="fecha" style="left:var(--dia-desde); width:calc(var(--dia-hasta) - var(--dia-desde));">@t.Dia</div>
            <div class="fecha" style="left:var(--mes-desde); width:calc(var(--mes-hasta) - var(--mes-desde));">@t.Mes</div>
            <div class="fecha" style="left:var(--anio-desde); width:calc(var(--anio-hasta) - var(--anio-desde));">@t.Anio</div>

            @* El nombre y el DNI van cada uno completo en un renglón (si no caben al final de uno, pasan enteros al siguiente). *@
            <div class="cuerpo">@t.Partes.Inicio<span class="junto">@t.Partes.Nombre</span>@t.Partes.Medio<span class="junto">@t.Partes.Dni</span>@t.Partes.Final</div>

            <div class="pruebas">@t.Pruebas</div>
        </div>
        <script id="ajuste-junto">
            // Un nombre (o un DNI) que no cabe ni en un renglón entero se achica lo justo para caber, en vez de salirse de la hoja (mínimo 10 pt).
            document.querySelectorAll('.cuerpo .junto').forEach(s => {
                const ancho = s.parentElement.clientWidth;
                let pt = parseFloat(getComputedStyle(s).fontSize) * 0.75;
                while (s.getBoundingClientRect().width > ancho && pt > 10) { pt -= 0.5; s.style.fontSize = pt + 'pt'; }
            });
        </script>
    }

    @if (Model.Imprimir && Model.Impedimento == null)
    {
        <script>window.addEventListener('load', () => window.print());</script>
    }
</body>
</html>
