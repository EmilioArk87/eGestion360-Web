@page "{id:int}"
@model eGestion360Web.Pages.Psicologia.Pacientes.DetalleModel
@using eGestion360Web.Models.Psicologia
@{
    ViewData["Title"] = "Expediente " + Model.Paciente.NumeroExpediente;
    var iniciales = string.Concat(Model.Nombre.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => p[0]));
}

<div class="container">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="/MainMenu">Menú Principal</a></li>
            <li class="breadcrumb-item"><a asp-page="/Psicologia/Index">Psicología</a></li>
            <li class="breadcrumb-item"><a asp-page="/Psicologia/Pacientes/Index">Pacientes</a></li>
            <li class="breadcrumb-item active" aria-current="page">@Model.Paciente.NumeroExpediente</li>
        </ol>
    </nav>

    @if (TempData["PacienteMensaje"] is string mensaje)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@mensaje
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }
    @if (TempData["PacienteAdvertencias"] is string advertencias)
    {
        <div class="alert alert-warning" role="alert"><i class="fas fa-exclamation-triangle me-2"></i>@advertencias</div>
    }
    @if (TempData["PacienteError"] is string error)
    {
        <div class="alert alert-danger" role="alert"><i class="fas fa-times-circle me-2"></i>@error</div>
    }

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <div class="d-flex align-items-center gap-3 mb-3">
                        <div class="rounded-circle bg-primary bg-opacity-10 text-primary d-flex align-items-center justify-content-center fw-semibold"
                             style="width:3.2rem;height:3.2rem;">@iniciales</div>
                        <div>
                            <div class="fw-semibold">@Model.Nombre</div>
                            <div class="small text-muted font-monospace">Expediente @Model.Paciente.NumeroExpediente</div>
                        </div>
                    </div>
                    <dl class="row small mb-0">
                        <dt class="col-6 text-muted fw-normal">DNI</dt><dd class="col-6 text-end font-monospace">@(Model.Dni ?? "—")</dd>
                        <dt class="col-6 text-muted fw-normal">Sexo</dt><dd class="col-6 text-end">@(Model.Sexo ?? "—")</dd>
                        <dt class="col-6 text-muted fw-normal">Apertura</dt><dd class="col-6 text-end">@Model.Paciente.FechaApertura.ToString("dd/MM/yyyy")</dd>
                        <dt class="col-6 text-muted fw-normal">Estado</dt><dd class="col-6 text-end">@(Model.Paciente.Activo ? "Activo" : "Inactivo")</dd>
                    </dl>
                </div>
            </div>
            <div class="alert alert-light border small mt-3 mb-0">
                <i class="fas fa-lock me-1"></i>Datos de salud confidenciales. El DNI completo solo se ve en el expediente y en el documento impreso.
            </div>
        </div>

        <div class="col-lg-8">
            @* ── Atenciones y pruebas aplicadas ── *@
            <div class="card border-0 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title mb-3"><i class="fas fa-notes-medical me-2"></i>Atenciones</h5>
                    @if (Model.Atenciones.Count == 0)
                    {
                        <p class="text-muted mb-0">Todavía no tiene atenciones.</p>
                    }
                    else
                    {
                        <ul class="list-group list-group-flush">
                            @foreach (var a in Model.Atenciones)
                            {
                                var aplicadas = Model.PruebasPorAtencion.TryGetValue(a.IdAtencion, out var lista) ? lista : new();
                                var editable = a.Estado == EstadosAtencion.Borrador && Model.PuedeRegistrarPruebas;
                                <li class="list-group-item px-0">
                                    <div class="d-flex justify-content-between align-items-center gap-2">
                                        <div>
                                            <div class="fw-semibold">@a.FechaAtencion.ToString("dd/MM/yyyy") · @(a.Jornada?.Nombre ?? "Consulta")</div>
                                            <div class="small text-muted">
                                                @(a.EdadDeclarada != null ? a.EdadDeclarada + " años" : "Sin edad registrada")
                                                @if (a.NombreProfesional != null) { <span> · @a.NombreProfesional</span> }
                                            </div>
                                        </div>
                                        <div class="d-flex align-items-center gap-2 flex-shrink-0">
                                            <span class="badge @(a.Estado == EstadosAtencion.Borrador ? "bg-warning text-dark" : a.Estado == EstadosAtencion.Cerrada ? "bg-success" : "bg-light text-muted border")">@a.Estado</span>
                                            <button type="button" class="btn btn-sm btn-outline-secondary" disabled title="Llega con el contenido del documento (F6)">
                                                <i class="fas fa-print me-1"></i>Imprimir
                                            </button>
                                        </div>
                                    </div>

                                    <div class="mt-2 small">
                                        <span class="text-muted me-1">Pruebas aplicadas:</span>
                                        @if (aplicadas.Count == 0)
                                        {
                                            <span class="text-muted fst-italic">ninguna registrada</span>
                                        }
                                        @foreach (var p in aplicadas)
                                        {
                                            <span class="badge bg-light text-primary border font-monospace me-1" title="@p.Nombre">@p.Codigo</span>
                                        }
                                        @if (editable)
                                        {
                                            <a class="ms-1" data-bs-toggle="collapse" href="#pruebas-@a.IdAtencion" role="button" aria-expanded="false" aria-controls="pruebas-@a.IdAtencion">
                                                <i class="fas fa-pen me-1"></i>@(aplicadas.Count == 0 ? "Registrar" : "Cambiar")
                                            </a>
                                        }
                                    </div>

                                    @if (editable)
                                    {
                                        <div class="collapse" id="pruebas-@a.IdAtencion">
                                            @if (Model.Catalogo.Count == 0 && aplicadas.Count == 0)
                                            {
                                                <div class="alert alert-light border small mt-2 mb-0">
                                                    El catálogo de pruebas está vacío.
                                                    @if (Model.PuedeVerCatalogos) { <a asp-page="/Psicologia/Catalogos/Index">Agrega las pruebas que aplica el centro.</a> }
                                                </div>
                                            }
                                            else
                                            {
                                                <form method="post" asp-page-handler="Pruebas" asp-route-id="@Model.Paciente.IdPaciente" class="border rounded p-2 mt-2 bg-light">
                                                    <input type="hidden" name="idAtencion" value="@a.IdAtencion" />
                                                    <div class="row row-cols-1 row-cols-md-2 g-1">
                                                        @foreach (var p in Model.Catalogo.Concat(aplicadas.Where(x => Model.Catalogo.All(c => c.Id != x.Id))))
                                                        {
                                                            var marcada = aplicadas.Any(x => x.Id == p.Id);
                                                            <div class="col">
                                                                <div class="form-check">
                                                                    <input class="form-check-input" type="checkbox" name="pruebas" value="@p.Id" id="ap-@a.IdAtencion-@p.Id" @(marcada ? "checked" : "") />
                                                                    <label class="form-check-label small" for="ap-@a.IdAtencion-@p.Id"><span class="font-monospace">@p.Codigo</span> · @p.Nombre</label>
                                                                </div>
                                                            </div>
                                                        }
                                                    </div>
                                                    <div class="text-end mt-2">
                                                        <button type="submit" class="btn btn-sm btn-primary"><i class="fas fa-save me-1"></i>Guardar pruebas</button>
                                                    </div>
                                                </form>
                                            }
                                        </div>
                                    }
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>

            @* ── Constancias ── *@
            @if (Model.PuedeVerConstancias)
            {
                <div class="card border-0 shadow-sm mt-4">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="card-title mb-0"><i class="fas fa-file-signature me-2"></i>Constancias de examen psicológico</h5>
                            @if (Model.PuedeEmitir && Model.Paciente.Activo)
                            {
                                <a asp-page="/Psicologia/Constancias/Emitir" asp-route-idPaciente="@Model.Paciente.IdPaciente" class="btn btn-sm btn-success">
                                    <i class="fas fa-plus me-1"></i>Emitir constancia
                                </a>
                            }
                        </div>
                        @if (Model.Constancias.Count == 0)
                        {
                            <p class="text-muted mb-0">Todavía no se le ha extendido ninguna constancia.</p>
                        }
                        else
                        {
                            <ul class="list-group list-group-flush">
                                @foreach (var c in Model.Constancias)
                                {
                                    var anulada = c.Estado == EstadosConstancia.Anulada;
                                    <li class="list-group-item px-0 @(anulada ? "text-muted" : "")">
                                        <div class="d-flex justify-content-between align-items-start gap-2">
                                            <div>
                                                <div>
                                                    <span class="font-monospace fw-semibold @(anulada ? "text-decoration-line-through" : "")">@c.Numero</span>
                                                    <span class="ms-1">· @c.Tipo</span>
                                                </div>
                                                <div class="small text-muted">
                                                    Emitida el @c.Fecha.ToString("dd/MM/yyyy")
                                                    @if (c.FechaAtencion != null) { <span> · evaluación del @c.FechaAtencion.Value.ToString("dd/MM/yyyy")</span> }
                                                    @if (c.Profesional != null) { <span> · @c.Profesional</span> }
                                                </div>
                                                <div class="small mt-1">
                                                    @if (c.Resultado != null)
                                                    {
                                                        <span class="badge @(c.Resultado == ResultadosConstancia.Apto ? "bg-success" : "bg-danger") me-1">@(c.Resultado == ResultadosConstancia.Apto ? "Apto" : "No apto")</span>
                                                    }
                                                    @foreach (var p in c.Pruebas)
                                                    {
                                                        <span class="badge bg-light text-primary border font-monospace me-1">@p</span>
                                                    }
                                                </div>
                                                @if (anulada && c.Motivo != null)
                                                {
                                                    <div class="small mt-1"><i class="fas fa-ban me-1"></i>Anulada: @c.Motivo</div>
                                                }
                                            </div>
                                            <div class="d-flex align-items-center gap-2 flex-shrink-0">
                                                <span class="badge @(anulada ? "bg-secondary" : "bg-success")">@c.Estado</span>
                                                @if (!anulada)
                                                {
                                                    @if (c.Imprimible && Model.PuedeImprimir)
                                                    {
                                                        <a asp-page="/Psicologia/Constancias/Imprimir" asp-route-id="@c.Id" target="_blank" rel="noopener" class="btn btn-sm btn-outline-primary" title="Imprimir sobre la hoja del Colegio">
                                                            <i class="fas fa-print"></i>
                                                        </a>
                                                    }
                                                    else
                                                    {
                                                        <button type="button" class="btn btn-sm btn-outline-secondary" disabled title="@(c.Imprimible ? "Tu rol no puede imprimir documentos" : "Este tipo de constancia todavía no tiene formato de impresión")">
                                                            <i class="fas fa-print"></i>
                                                        </button>
                                                    }
                                                    @if (Model.PuedeAnular)
                                                    {
                                                        <a class="btn btn-sm btn-outline-danger" data-bs-toggle="collapse" href="#anular-@c.Id" role="button" aria-expanded="false" aria-controls="anular-@c.Id" title="Anular">
                                                            <i class="fas fa-ban"></i>
                                                        </a>
                                                    }
                                                }
                                            </div>
                                        </div>
                                        @if (!anulada && Model.PuedeAnular)
                                        {
                                            <div class="collapse" id="anular-@c.Id">
                                                <form method="post" asp-page-handler="AnularConstancia" asp-route-id="@Model.Paciente.IdPaciente" class="border border-danger rounded p-2 mt-2">
                                                    <input type="hidden" name="idConstancia" value="@c.Id" />
                                                    <label class="form-label small mb-1" for="motivo-@c.Id">Motivo de la anulación de @c.Numero</label>
                                                    <div class="input-group input-group-sm">
                                                        <input type="text" class="form-control" id="motivo-@c.Id" name="motivo" maxlength="300" required placeholder="Por ejemplo: se emitió con el tipo equivocado" />
                                                        <button type="submit" class="btn btn-danger">Anular</button>
                                                    </div>
                                                    <div class="form-text">La constancia queda en el expediente como anulada y su número no se vuelve a usar.</div>
                                                </form>
                                            </div>
                                        }
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>
