@page "{id:int}"
@model eGestion360Web.Pages.Psicologia.Pacientes.EditarModel
@{
    ViewData["Title"] = "Editar paciente " + Model.Expediente;
}

<div class="container">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="/MainMenu">Menú Principal</a></li>
            <li class="breadcrumb-item"><a asp-page="/Psicologia/Index">Psicología</a></li>
            <li class="breadcrumb-item"><a asp-page="/Psicologia/Pacientes/Index">Pacientes</a></li>
            <li class="breadcrumb-item"><a asp-page="/Psicologia/Pacientes/Detalle" asp-route-id="@Model.IdPaciente">@Model.Expediente</a></li>
            <li class="breadcrumb-item active" aria-current="page">Editar</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <h2 class="mb-1"><i class="fas fa-user-edit me-2"></i>Editar paciente</h2>
            <p class="text-muted mb-0">Expediente <span class="font-monospace">@Model.Expediente</span>. Los cambios quedan en la bitácora con tu usuario.</p>
        </div>
        <a asp-page="/Psicologia/Pacientes/Detalle" asp-route-id="@Model.IdPaciente" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-2"></i>Volver</a>
    </div>

    <form method="post" asp-route-id="@Model.IdPaciente" class="card border-0 shadow-sm" novalidate>
        <input type="hidden" asp-for="Input.Token" />
        <div class="card-body">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3" role="alert"></div>

            <h6 class="text-muted text-uppercase small fw-semibold mb-3">Identificación</h6>
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <label asp-for="Input.Dni" class="form-label">DNI <span class="text-danger">*</span></label>
                    <input asp-for="Input.Dni" class="form-control font-monospace" placeholder="0000-0000-00000" inputmode="numeric" autocomplete="off" />
                    <span asp-validation-for="Input.Dni" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Input.Sexo" class="form-label">Sexo <span class="text-danger">*</span></label>
                    <select asp-for="Input.Sexo" class="form-select">
                        <option value="">Elige…</option>
                        <option value="M">Masculino</option>
                        <option value="F">Femenino</option>
                    </select>
                    <span asp-validation-for="Input.Sexo" class="text-danger small"></span>
                </div>
            </div>

            <h6 class="text-muted text-uppercase small fw-semibold mb-3">Nombre</h6>
            <div class="row g-3 mb-4">
                <div class="col-md-3">
                    <label asp-for="Input.PrimerNombre" class="form-label">Primer nombre <span class="text-danger">*</span></label>
                    <input asp-for="Input.PrimerNombre" class="form-control" autocomplete="off" />
                    <span asp-validation-for="Input.PrimerNombre" class="text-danger small"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="Input.SegundoNombre" class="form-label">Segundo nombre</label>
                    <input asp-for="Input.SegundoNombre" class="form-control" autocomplete="off" />
                    <span asp-validation-for="Input.SegundoNombre" class="text-danger small"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="Input.PrimerApellido" class="form-label">Primer apellido <span class="text-danger">*</span></label>
                    <input asp-for="Input.PrimerApellido" class="form-control" autocomplete="off" />
                    <span asp-validation-for="Input.PrimerApellido" class="text-danger small"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="Input.SegundoApellido" class="form-label">Segundo apellido</label>
                    <input asp-for="Input.SegundoApellido" class="form-control" autocomplete="off" />
                    <span asp-validation-for="Input.SegundoApellido" class="text-danger small"></span>
                </div>
            </div>

            <h6 class="text-muted text-uppercase small fw-semibold mb-3">Contacto <span class="text-lowercase fw-normal">(opcional)</span></h6>
            <div class="row g-3 mb-3">
                <div class="col-md-4">
                    <label asp-for="Input.Telefono" class="form-label">Teléfono</label>
                    <input asp-for="Input.Telefono" class="form-control" placeholder="9999-9999" inputmode="tel" autocomplete="off" />
                    <span asp-validation-for="Input.Telefono" class="text-danger small"></span>
                </div>
                <div class="col-md-5">
                    <label asp-for="Input.Correo" class="form-label">Correo</label>
                    <input asp-for="Input.Correo" type="email" class="form-control" autocomplete="off" />
                    <span asp-validation-for="Input.Correo" class="text-danger small"></span>
                </div>
            </div>

            <div class="alert alert-light border small mb-3">
                <i class="fas fa-info-circle me-1"></i>Son los datos de la persona: si también está registrada como empleado o cliente en otra empresa de la cuenta, el cambio se ve allí.
                La edad declarada y la jornada son de cada atención y no se cambian aquí.
            </div>

            <div class="d-flex flex-wrap gap-2 justify-content-end border-top pt-3">
                <a asp-page="/Psicologia/Pacientes/Detalle" asp-route-id="@Model.IdPaciente" class="btn btn-outline-secondary">Cancelar</a>
                <button type="submit" class="btn btn-primary"><i class="fas fa-save me-2"></i>Guardar cambios</button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
