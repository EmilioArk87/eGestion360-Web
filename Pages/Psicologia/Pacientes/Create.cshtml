@page
@model eGestion360Web.Pages.Psicologia.Pacientes.CreateModel
@{
    ViewData["Title"] = "Nuevo paciente";
    var ultimoId = TempData["PacienteUltimoId"] as string;
}

<div class="container">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="/MainMenu">Menú Principal</a></li>
            <li class="breadcrumb-item"><a asp-page="/Psicologia/Index">Psicología</a></li>
            <li class="breadcrumb-item"><a asp-page="/Psicologia/Pacientes/Index">Pacientes</a></li>
            <li class="breadcrumb-item active" aria-current="page">Nuevo paciente</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <h2 class="mb-1"><i class="fas fa-user-plus me-2"></i>Nuevo paciente</h2>
            <p class="text-muted mb-0">Registro de un paciente a la vez. Para el listado completo de una brigada, usa la importación desde Excel.</p>
        </div>
        <a asp-page="/Psicologia/Pacientes/Index" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-2"></i>Volver</a>
    </div>

    @if (TempData["PacienteMensaje"] is string mensaje)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@mensaje
            @if (ultimoId != null)
            {
                <a asp-page="/Psicologia/Pacientes/Detalle" asp-route-id="@ultimoId" class="alert-link ms-1">Ver su expediente</a>
            }
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }
    @if (TempData["PacienteAdvertencias"] is string advertencias)
    {
        <div class="alert alert-warning" role="alert"><i class="fas fa-exclamation-triangle me-2"></i>@advertencias</div>
    }

    <form method="post" class="card border-0 shadow-sm" novalidate>
        <div class="card-body">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3" role="alert"></div>

            <h6 class="text-muted text-uppercase small fw-semibold mb-3">Identificación</h6>
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <label asp-for="Input.Dni" class="form-label">DNI <span class="text-danger">*</span></label>
                    <input asp-for="Input.Dni" class="form-control font-monospace" placeholder="0000-0000-00000" inputmode="numeric" autocomplete="off" autofocus />
                    <span asp-validation-for="Input.Dni" class="text-danger small"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Input.Sexo" class="form-label">Sexo <span class="text-danger">*</span></label>
                    <select asp-for="Input.Sexo" class="form-select">
                        <option value="">Elige…</option>
                        <option value="M">Masculino</option>
                        <option value="F">Femenino</option>
                    </select>
                    <span asp-validation-for="Input.Sexo" class="text-danger small"></span>
                </div>
            </div>

            <h6 class="text-muted text-uppercase small fw-semibold mb-3">Nombre</h6>
            <div class="row g-3 mb-4">
                <div class="col-md-3">
                    <label asp-for="Input.PrimerNombre" class="form-label">Primer nombre <span class="text-danger">*</span></label>
                    <input asp-for="Input.PrimerNombre" class="form-control" autocomplete="off" />
                    <span asp-validation-for="Input.PrimerNombre" class="text-danger small"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="Input.SegundoNombre" class="form-label">Segundo nombre</label>
                    <input asp-for="Input.SegundoNombre" class="form-control" autocomplete="off" />
                    <span asp-validation-for="Input.SegundoNombre" class="text-danger small"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="Input.PrimerApellido" class="form-label">Primer apellido <span class="text-danger">*</span></label>
                    <input asp-for="Input.PrimerApellido" class="form-control" autocomplete="off" />
                    <span asp-validation-for="Input.PrimerApellido" class="text-danger small"></span>
                </div>
                <div class="col-md-3">
                    <label asp-for="Input.SegundoApellido" class="form-label">Segundo apellido</label>
                    <input asp-for="Input.SegundoApellido" class="form-control" autocomplete="off" />
                    <span asp-validation-for="Input.SegundoApellido" class="text-danger small"></span>
                </div>
            </div>

            <h6 class="text-muted text-uppercase small fw-semibold mb-3">Contacto <span class="text-lowercase fw-normal">(opcional)</span></h6>
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <label asp-for="Input.Telefono" class="form-label">Teléfono</label>
                    <input asp-for="Input.Telefono" class="form-control" placeholder="9999-9999" inputmode="tel" autocomplete="off" />
                    <span asp-validation-for="Input.Telefono" class="text-danger small"></span>
                </div>
                <div class="col-md-5">
                    <label asp-for="Input.Correo" class="form-label">Correo</label>
                    <input asp-for="Input.Correo" type="email" class="form-control" autocomplete="off" />
                    <span asp-validation-for="Input.Correo" class="text-danger small"></span>
                </div>
            </div>

            <h6 class="text-muted text-uppercase small fw-semibold mb-3">Atención</h6>
            <div class="row g-3 mb-2">
                <div class="col-md-6">
                    <label asp-for="Input.IdJornada" class="form-label">Jornada o brigada</label>
                    <select asp-for="Input.IdJornada" class="form-select">
                        <option value="">Ninguna: registro individual</option>
                        @foreach (var j in Model.Jornadas)
                        {
                            <option value="@j.IdJornada">@j.Nombre (@j.Fecha.ToString("dd/MM/yyyy"))</option>
                        }
                    </select>
                    <span asp-validation-for="Input.IdJornada" class="text-danger small"></span>
                    <div class="form-text">Con una jornada, el paciente queda con su atención en borrador en ella, como en la importación.</div>
                </div>
                <div class="col-md-2">
                    <label asp-for="Input.Edad" class="form-label">Edad</label>
                    <input asp-for="Input.Edad" type="number" min="0" max="120" class="form-control" />
                    <span asp-validation-for="Input.Edad" class="text-danger small"></span>
                </div>
            </div>
            <div class="form-text mb-4">La edad se anota en la atención de la jornada; sin jornada no se pide.</div>

            <div class="d-flex flex-wrap gap-2 justify-content-end border-top pt-3">
                <a asp-page="/Psicologia/Pacientes/Index" class="btn btn-outline-secondary">Cancelar</a>
                <button type="submit" name="accion" value="otro" class="btn btn-outline-success"><i class="fas fa-plus me-2"></i>Guardar y registrar otro</button>
                <button type="submit" name="accion" value="guardar" class="btn btn-success"><i class="fas fa-save me-2"></i>Guardar</button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const jornada = document.getElementById('Input_IdJornada');
            const edad = document.getElementById('Input_Edad');
            if (!jornada || !edad) return;
            const sincronizar = () => {
                edad.disabled = !jornada.value;
                if (!jornada.value) edad.value = '';
            };
            jornada.addEventListener('change', sincronizar);
            sincronizar();
        })();
    </script>
}
