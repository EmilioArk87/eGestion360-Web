@page
@model eGestion360Web.Pages.Psicologia.Catalogos.IndexModel
@{
    ViewData["Title"] = "Catálogos de Psicología";
}

<div class="container">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="/MainMenu">Menú Principal</a></li>
            <li class="breadcrumb-item"><a asp-page="/Psicologia/Index">Psicología</a></li>
            <li class="breadcrumb-item active" aria-current="page">Catálogos</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <h2 class="mb-1"><i class="fas fa-list-check me-2"></i>Catálogos</h2>
            <p class="text-muted mb-0">Pruebas psicológicas que aplica el centro y tipos de constancia que extiende</p>
        </div>
        <a asp-page="/Psicologia/Index" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-2"></i>Volver</a>
    </div>

    <div class="row g-4">

        <!-- Pruebas psicológicas -->
        <div class="col-md-6 col-lg-4" eg-si-puede-abrir="/Psicologia/Catalogos/Pruebas">
            <div class="card h-100 shadow-sm border-0 menu-card">
                <div class="card-body text-center p-4">
                    <div class="menu-icon text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                         style="width: 4.5rem; height: 4.5rem; background-color: #20c997;">
                        <i class="fas fa-clipboard-list fa-2x"></i>
                    </div>
                    <h5 class="card-title fw-bold mb-2">Pruebas psicológicas</h5>
                    <p class="card-text text-muted small mb-4">Las que se marcan en cada atención y se declaran en las constancias</p>
                    <a asp-page="/Psicologia/Catalogos/Pruebas" class="btn w-100 text-white" style="background-color: #20c997;">
                        <i class="fas fa-arrow-right me-2"></i>Acceder
                    </a>
                </div>
            </div>
        </div>

        <!-- Tipos de constancia -->
        <div class="col-md-6 col-lg-4" eg-si-puede-abrir="/Psicologia/Catalogos/TiposConstancia">
            <div class="card h-100 shadow-sm border-0 menu-card">
                <div class="card-body text-center p-4">
                    <div class="menu-icon text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                         style="width: 4.5rem; height: 4.5rem; background-color: #d63384;">
                        <i class="fas fa-file-signature fa-2x"></i>
                    </div>
                    <h5 class="card-title fw-bold mb-2">Tipos de constancia</h5>
                    <p class="card-text text-muted small mb-4">Numeración, talonario del Colegio y formato de impresión de cada tipo</p>
                    <a asp-page="/Psicologia/Catalogos/TiposConstancia" class="btn w-100 text-white" style="background-color: #d63384;">
                        <i class="fas fa-arrow-right me-2"></i>Acceder
                    </a>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <style>
        .menu-card { transition: transform 0.25s ease, box-shadow 0.25s ease; }
        .menu-card:hover { transform: translateY(-4px); box-shadow: 0 0.5rem 1rem rgba(0,0,0,0.12) !important; }
    </style>
}
