@page
@model eGestion360Web.Pages.Empresas.CreateModel
@{
    ViewData["Title"] = "Nueva Empresa";
}

<div class="container">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="/MainMenu">Menú Principal</a></li>
            <li class="breadcrumb-item"><a asp-page="Index">Empresas</a></li>
            <li class="breadcrumb-item active" aria-current="page">Nueva</li>
        </ol>
    </nav>

    <h2 class="mb-4"><i class="fas fa-plus-circle me-2"></i>Nueva Empresa</h2>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                <div class="row g-3 mb-3">
                    <div class="col-md-8">
                        <label asp-for="Empresa.IdTenant" class="form-label"></label>
                        <select asp-for="Empresa.IdTenant" asp-items="ViewBag.Tenants" class="form-select" required>
                            <option value="">-- Seleccione --</option>
                        </select>
                        <span asp-validation-for="Empresa.IdTenant" class="text-danger"></span>
                        <div class="form-text">La cuenta comercial a la que pertenece la empresa. No se puede cambiar después.</div>
                    </div>
                </div>

                @{ await Html.RenderPartialAsync("_EmpresaForm", Model.Empresa, new ViewDataDictionary(ViewData) { TemplateInfo = { HtmlFieldPrefix = "Empresa" } }); }

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-2"></i>Guardar
                    </button>
                    <a asp-page="Index" class="btn btn-outline-secondary">
                        <i class="fas fa-times me-2"></i>Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
