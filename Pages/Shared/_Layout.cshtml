@using eGestion360Web.Models.Plataforma
@using eGestion360Web.Services
@using eGestion360Web.Services.Navegacion
@inject INavegacionService Navegacion
@{
    // Menú configurable por usuario: cada persona con sesión ve el estilo que eligió (claim de la cookie, sin ir a la base); sin sesión, la
    // barra de siempre. Los tres estilos salen del mismo catálogo de navegación, ya recortado por módulos activos y permisos.
    var conSesion = AuthHelper.IsAuthenticated(Context);
    var estiloMenu = conSesion ? AuthHelper.GetEstiloMenu(Context) : EstilosDeMenu.Hub;
    var vistaMenu = new VistaDeMenu(
        conSesion ? await Navegacion.ObtenerAsync() : MenuDeNavegacion.Vacio,
        (ViewContext.ActionDescriptor as Microsoft.AspNetCore.Mvc.RazorPages.PageActionDescriptor)?.ViewEnginePath,
        estiloMenu);
}
<!DOCTYPE html>
<html lang="es" data-eg-menu="@estiloMenu">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - eGestion360</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/password-checklist.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/menu.css" asp-append-version="true" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <!-- Iconos de la app: pestaña del navegador, barra de tareas y app instalada -->
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="icon" href="~/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" sizes="180x180" href="~/img/apple-touch-icon.png" />
    <link rel="manifest" href="~/site.webmanifest" />
    <meta name="application-name" content="eGestión360" />
    <meta name="theme-color" content="#1B63C9" />
    @if (estiloMenu == EstilosDeMenu.Sidebar)
    {
        @* Antes de pintar: la barra lateral arranca colapsada si así la dejó la persona (sin parpadeo). *@
        <script>try { if (localStorage.getItem('eg360.menu.colapsado') === '1') document.documentElement.classList.add('egm-colapsado'); } catch (e) { }</script>
    }
    @await RenderSectionAsync("Head", required: false)
</head>
<body class="egm-@estiloMenu">
    @if (estiloMenu == EstilosDeMenu.Sidebar)
    {
        <partial name="~/Pages/Shared/Menu/_MenuSidebar.cshtml" model="vistaMenu" />
    }
    else if (estiloMenu == EstilosDeMenu.Topbar)
    {
        <partial name="~/Pages/Shared/Menu/_MenuTopbarMega.cshtml" model="vistaMenu" />
    }
    else
    {
        <partial name="~/Pages/Shared/Menu/_MenuHub.cshtml" model="vistaMenu" />
    }
    @if (conSesion)
    {
        <partial name="~/Pages/Shared/Menu/_BuscadorRapido.cshtml" model="vistaMenu" />
    }
    <div class="container-fluid">
        <main role="main" class="py-4">
            @RenderBody()
        </main>
    </div>

    <footer class="bg-dark text-light py-4 mt-5">
        <div class="container">
            <div class="row">
                <div class="col-md-6">
                    <img src="~/img/logo-blanco.svg" alt="eGestión360" height="42" class="mb-2" />
                    <p class="mb-0">Sistema de Gestión Web desarrollado por SIP Tecnología</p>
                </div>
                <div class="col-md-6 text-md-end">
                    <p class="mb-0">&copy; @DateTime.Now.Year - SIP Tecnología - Todos los derechos reservados</p>
                    <small class="text-muted">
                        <a href="#" class="text-muted me-3"><i class="fas fa-envelope me-1"></i>info@siptech.com</a>
                        <a href="#" class="text-muted"><i class="fas fa-phone me-1"></i>+1 234 567 890</a>
                    </small>
                </div>
            </div>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/menu.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
