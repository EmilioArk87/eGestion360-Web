@using System.Text.Json
@using eGestion360Web.Services
@model eGestion360Web.Pages.Shared.PasswordChecklistModel
@*
    Checklist de contraseña en vivo. Las reglas salen de Services/PasswordPolicy.cs,
    así que cliente y servidor no se desincronizan.

    Uso:
        <partial name="_PasswordChecklist"
                 model='new PasswordChecklistModel("Password", "ConfirmPassword", "Username", "Email")' />

    Los nombres son los id de los inputs. La confirmación y el contexto son opcionales.
    Requiere ~/js/password-checklist.js en la sección Scripts de la página.
*@
<div class="password-checklist-box"
     data-password-checklist
     data-password="@Model.IdPassword"
     data-confirmacion="@Model.IdConfirmacion"
     data-contexto="@string.Join(",", Model.IdsContexto)"
     data-reglas="@JsonSerializer.Serialize(PasswordPolicy.ReglasParaCliente())">
    <p class="password-checklist__titulo">La contraseña necesita:</p>
</div>
