@page
@using eGestion360Web.Services.Identidad
@model AceptarInvitacionModel
@{
    ViewData["Title"] = "Activar tu cuenta";
    ViewData["Subtitulo"] = "Activa tu cuenta";
    Layout = "_LayoutEntrada";
}

@if (Model.Consulta.Estado == EstadoDeConsulta.Valida)
{
    <form method="post" class="login-form" autocomplete="off">
        <input type="hidden" asp-for="Token" />

        <p class="text-muted">
            Te invitaron a <strong>@Model.Consulta.Empresa</strong>. Elige la contraseña con la que vas a entrar con tu correo
            <strong>@Model.Consulta.Correo</strong>.
        </p>
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="form-group mb-3">
            <div class="input-group">
                <span class="input-group-text"><i class="fas fa-lock"></i></span>
                <input asp-for="Password" class="form-control" placeholder="Contraseña" autocomplete="new-password" autofocus />
                <button class="btn btn-outline-secondary" type="button" data-toggle-password="Password" aria-label="Mostrar contraseña">
                    <i class="fas fa-eye"></i>
                </button>
            </div>
            <span asp-validation-for="Password" class="text-danger small"></span>
        </div>

        <div class="form-group mb-3">
            <div class="input-group">
                <span class="input-group-text"><i class="fas fa-lock"></i></span>
                <input asp-for="ConfirmPassword" class="form-control" placeholder="Repite la contraseña" autocomplete="new-password" />
                <button class="btn btn-outline-secondary" type="button" data-toggle-password="ConfirmPassword" aria-label="Mostrar contraseña">
                    <i class="fas fa-eye"></i>
                </button>
            </div>
            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
        </div>

        <partial name="_PasswordChecklist" model='new PasswordChecklistModel("Password", "ConfirmPassword")' />

        <div class="d-flex gap-2">
            <a href="/Login" class="btn btn-danger btn-home" title="Cancelar"><i class="fas fa-times"></i></a>
            <button type="submit" class="btn btn-primary btn-login flex-grow-1"><i class="fas fa-check"></i> Activar mi cuenta</button>
        </div>
    </form>
}
else
{
    <div class="login-form">
        <div class="alert alert-warning" role="alert"><i class="fas fa-exclamation-triangle me-1"></i> @Model.MensajeDeEstado</div>
        <a href="/Login" class="btn btn-primary btn-login w-100"><i class="fas fa-sign-in-alt"></i> Ir a iniciar sesión</a>
    </div>
}

@section Scripts {
    @if (Model.Consulta.Estado == EstadoDeConsulta.Valida)
    {
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
        <script src="~/js/password-checklist.js" asp-append-version="true"></script>
        <script src="~/js/toggle-password.js" asp-append-version="true"></script>
    }
}
