@page
@model eGestion360Web.Pages.Facturacion.Notas.IndexModel
@{
    ViewData["Title"] = "Notas de crédito/débito";
}

<div class="container">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="/MainMenu">Menú</a></li>
            <li class="breadcrumb-item"><a asp-page="/Facturacion/Index">Facturación</a></li>
            <li class="breadcrumb-item active">Notas</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <h2 class="mb-1"><i class="fas fa-file-medical me-2"></i>Notas de crédito / débito</h2>
            <p class="text-muted mb-0">Documentos que ajustan el saldo de facturas emitidas</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-page="Create" asp-route-tipo="credito" class="btn btn-success">
                <i class="fas fa-minus-circle me-2"></i>Nueva NC
            </a>
            <a asp-page="Create" asp-route-tipo="debito" class="btn btn-warning">
                <i class="fas fa-plus-circle me-2"></i>Nueva ND
            </a>
            <a asp-page="/Facturacion/Index" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-2"></i>Volver</a>
        </div>
    </div>

    @if (TempData["NotasMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle me-2"></i>@TempData["NotasMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <form method="get" class="card border-0 shadow-sm mb-3">
        <div class="card-body py-2">
            <div class="d-flex gap-2 align-items-center">
                <label class="mb-0 small">Filtrar tipo:</label>
                <a asp-page="Index" class="btn btn-sm @(string.IsNullOrEmpty(Model.Tipo) ? "btn-primary" : "btn-outline-primary")">Todos</a>
                <a asp-page="Index" asp-route-tipo="credito" class="btn btn-sm @(Model.Tipo == "credito" ? "btn-success" : "btn-outline-success")">Crédito</a>
                <a asp-page="Index" asp-route-tipo="debito"  class="btn btn-sm @(Model.Tipo == "debito"  ? "btn-warning" : "btn-outline-warning")">Débito</a>
            </div>
        </div>
    </form>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-sm table-hover mb-0 align-middle">
                    <thead class="table-light small">
                        <tr>
                            <th>Documento</th>
                            <th>Tipo</th>
                            <th>Fecha</th>
                            <th>Cliente</th>
                            <th>Factura origen</th>
                            <th>Motivo</th>
                            <th class="text-end">Monto</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Notas.Any())
                        {
                            <tr><td colspan="7" class="text-center text-muted py-4">Sin notas registradas.</td></tr>
                        }
                        else
                        {
                            foreach (var n in Model.Notas)
                            {
                                <tr>
                                    <td><code>@n.Serie-@(n.Numero?.ToString("D6"))</code></td>
                                    <td>
                                        @if (n.Tipo == "credito") { <span class="badge bg-success">CRÉDITO</span> }
                                        else { <span class="badge bg-warning text-dark">DÉBITO</span> }
                                    </td>
                                    <td>@n.FechaEmision.ToString("yyyy-MM-dd")</td>
                                    <td>@n.Cliente.RazonSocial</td>
                                    <td>
                                        <a asp-page="/Facturacion/Details" asp-route-id="@n.IdFacturaOrigen">
                                            <code>@n.FacturaOrigen.Serie-@(n.FacturaOrigen.Numero?.ToString("D6"))</code>
                                        </a>
                                    </td>
                                    <td><small>@n.Motivo</small></td>
                                    <td class="text-end fw-bold @(n.Tipo == "credito" ? "text-success" : "text-warning")">
                                        @(n.Tipo == "credito" ? "-" : "+")@n.Monto.ToString("N2") @n.Moneda
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
