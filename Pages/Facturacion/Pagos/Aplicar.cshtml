@page "{id:int}"
@model eGestion360Web.Pages.Facturacion.Pagos.AplicarModel
@{
    ViewData["Title"] = "Aplicar saldo a favor";
}

@if (Model.Pago is null) { return; }
@{ var p = Model.Pago; }

<div class="container">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="/MainMenu">Menú</a></li>
            <li class="breadcrumb-item"><a asp-page="/Facturacion/Index">Facturación</a></li>
            <li class="breadcrumb-item"><a asp-page="Index">Pagos</a></li>
            <li class="breadcrumb-item"><a asp-page="Details" asp-route-id="@p.IdPago">@p.Serie-@(p.Numero?.ToString("D6"))</a></li>
            <li class="breadcrumb-item active">Aplicar</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <h2 class="mb-1"><i class="fas fa-link me-2"></i>Aplicar saldo a favor</h2>
            <p class="text-muted mb-0">Pago @p.Serie-@(p.Numero?.ToString("D6")) · @p.Cliente.RazonSocial</p>
        </div>
        <a asp-page="Details" asp-route-id="@p.IdPago" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-2"></i>Volver
        </a>
    </div>

    <div class="alert alert-info">
        Saldo disponible para aplicar: <strong>@p.SaldoFavor.ToString("N2") @p.Moneda</strong>
    </div>

    <form method="post">
        <div asp-validation-summary="All" class="alert alert-danger" style="display: @(ViewData.ModelState.ErrorCount > 0 ? "block" : "none")"></div>

        <div class="card border-0 shadow-sm">
            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                <strong>Facturas pendientes del cliente</strong>
                <span class="badge bg-info" id="info">Aplicado: 0.00 / @p.SaldoFavor.ToString("N2")</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm mb-0 align-middle">
                        <thead class="table-light small">
                            <tr>
                                <th style="width:40px;"></th>
                                <th>Documento</th>
                                <th>Emisión</th>
                                <th>Vence</th>
                                <th class="text-end">Total</th>
                                <th class="text-end">Saldo</th>
                                <th class="text-end" style="width:180px;">A aplicar</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.FacturasPendientes.Any())
                            {
                                <tr><td colspan="7" class="text-center text-muted py-3">No hay facturas pendientes en moneda @p.Moneda.</td></tr>
                            }
                            else
                            {
                                int i = 0;
                                foreach (var f in Model.FacturasPendientes)
                                {
                                    <tr data-saldo="@f.Saldo">
                                        <td><input type="checkbox" class="chk-fac" /></td>
                                        <td><code>@f.Doc</code></td>
                                        <td>@f.FechaEmision.ToString("yyyy-MM-dd")</td>
                                        <td>@(f.FechaVencimiento?.ToString("yyyy-MM-dd") ?? "—")</td>
                                        <td class="text-end">@f.Total.ToString("N2")</td>
                                        <td class="text-end fw-bold">@f.Saldo.ToString("N2")</td>
                                        <td>
                                            <input type="hidden" name="Aplicaciones[@i].IdFactura" value="@f.IdFactura" />
                                            <input type="number" step="0.01" min="0" max="@f.Saldo" value="0"
                                                   class="form-control form-control-sm text-end fld-aplicar"
                                                   name="Aplicaciones[@i].Monto" />
                                        </td>
                                    </tr>
                                    i++;
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-2 mt-3 mb-4">
            <a asp-page="Details" asp-route-id="@p.IdPago" class="btn btn-outline-secondary">Cancelar</a>
            <button type="submit" class="btn btn-success">
                <i class="fas fa-link me-2"></i>Aplicar
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        const SALDO_FAVOR = @p.SaldoFavor;

        document.querySelectorAll('.chk-fac').forEach(chk => {
            chk.addEventListener('change', () => {
                const tr = chk.closest('tr');
                const saldoFac = parseFloat(tr.dataset.saldo);
                const inp = tr.querySelector('.fld-aplicar');
                inp.value = chk.checked ? Math.min(saldoFac, restanteDisponible(tr)).toFixed(2) : '0';
                recalc();
            });
        });
        document.querySelectorAll('.fld-aplicar').forEach(inp => inp.addEventListener('input', recalc));

        function restanteDisponible(excluirTr) {
            let usado = 0;
            document.querySelectorAll('.fld-aplicar').forEach(inp => {
                if (inp.closest('tr') !== excluirTr) usado += parseFloat(inp.value || '0');
            });
            return Math.max(0, SALDO_FAVOR - usado);
        }

        function recalc() {
            let total = 0;
            document.querySelectorAll('.fld-aplicar').forEach(inp => total += parseFloat(inp.value || '0'));
            const info = document.getElementById('info');
            info.textContent = `Aplicado: ${total.toFixed(2)} / ${SALDO_FAVOR.toFixed(2)}`;
            info.className = total > SALDO_FAVOR
                ? 'badge bg-danger'
                : (total === SALDO_FAVOR ? 'badge bg-success' : 'badge bg-warning text-dark');
        }
    </script>
}
