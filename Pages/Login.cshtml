@page
@model LoginModel
@{
    ViewData["Title"] = "Iniciar Sesión";
    Layout = null; // La página de login no usa el layout principal
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - eGestion360</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
</head>
<body class="login-body">
    <div class="login-container">
        <div class="login-card">
            <div class="login-header">
                <div class="logo-container">
                    <i class="fas fa-chart-line logo-icon"></i>
                    <h2 class="login-title">eGestion360</h2>
                </div>
                <p class="login-subtitle">Sistema de Gestión Web</p>
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success" role="alert">
                    @TempData["SuccessMessage"]
                </div>
            }

            <form method="post" class="login-form">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                
                <div class="form-group">
                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="fas fa-user"></i>
                        </span>
                        <input asp-for="Username" class="form-control" placeholder="Usuario" />
                    </div>
                    <span asp-validation-for="Username" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="fas fa-lock"></i>
                        </span>
                        <input asp-for="Password" class="form-control" id="inputPassword" placeholder="Contraseña" />
                        <button class="btn btn-toggle-password" type="button" id="btnTogglePassword"
                                aria-label="Mostrar contraseña" data-bs-toggle="tooltip" data-bs-placement="top" title="Mostrar contraseña">
                            <i class="fas fa-eye" id="iconTogglePassword"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>

                <div class="form-check mb-3">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label">
                        Recordarme
                    </label>
                </div>

                <div class="d-flex gap-2">
                    <a href="/Index" class="btn btn-danger btn-home" data-bs-toggle="tooltip" data-bs-placement="top" title="Cancelar e ir a inicio">
                        <i class="fas fa-home"></i>
                    </a>
                    <button type="submit" class="btn btn-primary btn-login flex-grow-1">
                        <i class="fas fa-sign-in-alt"></i> Iniciar Sesión
                    </button>
                </div>

                <div class="text-center mt-3">
                    <p class="mb-2">¿No tienes cuenta? 
                        <a href="/Register" class="text-decoration-none">
                            <i class="fas fa-user-plus me-1"></i>Registrarse
                        </a>
                    </p>
                    <p class="mb-0">
                        <a href="/ForgotPassword" class="text-decoration-none">
                            <i class="fas fa-key me-1"></i>¿Olvidaste tu contraseña?
                        </a>
                    </p>
                </div>
            </form>
        </div>
    </div>

    <footer class="bg-dark text-light py-4 mt-5" style="position: fixed; bottom: 0; width: 100%; left: 0;">
        <div class="container">
            <div class="row">
                <div class="col-md-6">
                    <h5><i class="fas fa-chart-line me-2"></i>eGestion360</h5>
                    <p class="mb-0">Sistema de Gestión Web desarrollado por SIP Tecnología</p>
                </div>
                <div class="col-md-6 text-md-end">
                    <p class="mb-0">&copy; @DateTime.Now.Year - SIP Tecnología - Todos los derechos reservados</p>
                    <small class="text-muted">
                        <a href="#" class="text-muted me-3"><i class="fas fa-envelope me-1"></i>info@siptech.com</a>
                        <a href="#" class="text-muted"><i class="fas fa-phone me-1"></i>+1 234 567 890</a>
                    </small>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        // Inicializar tooltips de Bootstrap
        document.addEventListener('DOMContentLoaded', function() {
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });

            // Mostrar / ocultar la contraseña
            document.getElementById('btnTogglePassword').addEventListener('click', function () {
                var input = document.getElementById('inputPassword');
                var icon = document.getElementById('iconTogglePassword');
                var mostrar = input.type === 'password';

                input.type = mostrar ? 'text' : 'password';
                icon.classList.replace(mostrar ? 'fa-eye' : 'fa-eye-slash', mostrar ? 'fa-eye-slash' : 'fa-eye');

                var texto = mostrar ? 'Ocultar contraseña' : 'Mostrar contraseña';
                this.setAttribute('aria-label', texto);

                // Bootstrap 5.1 no refresca el título de un tooltip ya creado:
                // se descarta la instancia y se crea otra con el texto nuevo.
                var tooltip = bootstrap.Tooltip.getInstance(this);
                if (tooltip) {
                    tooltip.dispose();
                }
                this.setAttribute('title', texto);
                new bootstrap.Tooltip(this);

                input.focus();
            });
        });
    </script>
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
</body>
</html>