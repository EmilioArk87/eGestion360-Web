@page
@model MainMenuModel
@using eGestion360Web.Services.Navegacion
@{
    ViewData["Title"] = "Menú Principal";
    var primerNombre = (Model.NombrePersona ?? string.Empty).Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? Model.NombrePersona;
    var grupos = Model.Menu.Grupos.ToList();
}

@* Hub renovado (estilo «hub» del menú configurable): buscador en vivo, accesos frecuentes, filtros por categoría y tarjetas con accesos directos.
   Todas las tarjetas y enlaces salen del catálogo de navegación ya recortado: el módulo activo para la empresa y solo las pantallas que la
   persona puede abrir (la misma pregunta que hace cada pantalla). Todos ven el mismo menú, sin ramas por rol (D22, F8). *@

<div class="egm-hub-cabecera mb-0" style="margin-top:-1.5rem;">
    <div class="container">
        @if (TempData["WarningMessage"] != null)
        {
            <div class="alert alert-warning d-flex align-items-center mb-3" role="alert">
                <i class="fas fa-shield-alt me-2"></i>
                <div>@TempData["WarningMessage"] <a asp-page="/MfaAlta" class="alert-link">Activar ahora</a></div>
            </div>
        }
        <div class="row align-items-center g-3">
            <div class="col-lg-6">
                <h3 class="fw-bold mb-1">Hola, @primerNombre</h3>
                <p class="mb-0 opacity-75 small">Entra directo a tus módulos o escribe el nombre de cualquier pantalla para ir sin rodeos.</p>
            </div>
            <div class="col-lg-6">
                <div class="egm-hub-caja">
                    <i class="fas fa-search text-muted ms-1"></i>
                    <input type="text" id="egm-hub-filtro" autocomplete="off" aria-label="Buscar módulo o pantalla"
                           placeholder="Buscar módulo o pantalla (salidas, facturas, pacientes, roles…)" />
                    <kbd class="bg-light text-muted border rounded px-2 py-1 d-none d-sm-inline" style="font-size:.7rem;" title="Enter abre la primera coincidencia">Enter</kbd>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container egm-hub-cuerpo pb-4">
    <div class="d-flex align-items-center gap-2 flex-wrap mb-4" id="egm-frecuentes-bloque" hidden>
        <span class="badge bg-dark py-2 px-3 rounded-pill"><i class="fas fa-star text-warning me-1"></i>Frecuentes</span>
        <div class="d-flex align-items-center gap-2 flex-wrap" id="egm-frecuentes"></div>
    </div>

    @if (Model.Menu.EstaVacio)
    {
        <div class="alert alert-light border text-center py-5">
            <i class="fas fa-th-large fa-2x text-muted mb-3 d-block"></i>
            Todavía no tienes pantallas disponibles en este sitio. Si crees que es un error, pide a quien administra tu empresa que revise tus módulos y tu rol.
        </div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
            <div class="d-flex gap-2 flex-wrap">
                <button type="button" class="egm-filtro activo" data-egm-filtro="todos">Todos</button>
                @if (grupos.Count > 1)
                {
                    foreach (var grupo in grupos)
                    {
                        <button type="button" class="egm-filtro" data-egm-filtro="@MainMenuModel.Categoria(grupo)">
                            @(grupo == GrupoDeNavegacion.Operacion ? "Módulos de operación" : grupo == GrupoDeNavegacion.Empresa ? "Administración de la empresa" : "Administración del sistema")
                        </button>
                    }
                }
            </div>
            <small class="text-muted" id="egm-hub-conteo"></small>
        </div>

        <div class="row g-3">
            @foreach (var m in Model.Menu.Modulos)
            {
                var indice = m.RutaIndice ?? m.PantallasListas.FirstOrDefault()?.Ruta;
                <div class="col-md-6 col-lg-4" data-egm-tarjeta data-egm-cat="@MainMenuModel.Categoria(m.Grupo)" data-egm-texto="@MainMenuModel.TextoDeBusqueda(m)">
                    <div class="egm-tarjeta">
                        @if (indice != null)
                        {
                            <a href="@Url.Page(indice)" class="egm-tarjeta-cabeza">
                                <span class="egm-tarjeta-ico" style="background:@m.Color;"><i class="fas @m.Icono"></i></span>
                                <div>
                                    <h6 class="fw-bold mb-0">@m.Titulo</h6>
                                    <small class="text-muted">@m.Descripcion</small>
                                </div>
                            </a>
                        }
                        else
                        {
                            <div class="egm-tarjeta-cabeza">
                                <span class="egm-tarjeta-ico" style="background:@m.Color;"><i class="fas @m.Icono"></i></span>
                                <div>
                                    <h6 class="fw-bold mb-0">@m.Titulo <span class="egm-pronto ms-1">Próximamente</span></h6>
                                    <small class="text-muted">@m.Descripcion</small>
                                </div>
                            </div>
                        }
                        @if (m.Pantallas.Count > 0)
                        {
                            <div class="egm-sublinks">
                                @foreach (var p in m.Pantallas)
                                {
                                    if (p.Proximamente)
                                    {
                                        <span class="egm-sublink" title="Próximamente">@p.Titulo</span>
                                    }
                                    else
                                    {
                                        <a href="@Url.Page(p.Ruta)" class="egm-sublink" title="@p.Descripcion">@p.Titulo</a>
                                    }
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
        <div class="text-center text-muted py-4" id="egm-hub-vacio" hidden>
            <i class="fas fa-search me-2"></i>Ningún módulo coincide con lo que escribiste. Prueba con <kbd>Ctrl</kbd>+<kbd>K</kbd> para buscar entre todas las pantallas.
        </div>
    }

    <div class="row mt-5">
        <div class="col-12">
            <div class="card border-0 bg-light">
                <div class="card-body p-4">
                    <div class="row align-items-center">
                        <div class="col-md-8">
                            <h5 class="mb-2"><i class="fas fa-info-circle me-2"></i>Información del Sistema</h5>
                            <p class="text-muted mb-0">
                                <strong>Persona:</strong> @Model.NombrePersona<br>
                                <strong>Usuario:</strong> @Model.Username<br>
                                <strong>Email:</strong> @Model.Email<br>
                                <strong>Última conexión:</strong> @DateTime.Now.ToString("dd/MM/yyyy HH:mm")
                            </p>
                        </div>
                        <div class="col-md-4 text-md-end mt-3 mt-md-0">
                            <a asp-page="/Preferencias/EstiloMenu" class="btn btn-outline-primary me-2 mb-2 mb-md-0">
                                <i class="fas fa-palette me-2"></i>Estilo de menú
                            </a>
                            <a asp-page="/Logout" asp-page-handler="Logout" class="btn btn-outline-danger">
                                <i class="fas fa-sign-out-alt me-2"></i>Cerrar Sesión
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
