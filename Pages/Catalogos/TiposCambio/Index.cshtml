@page
@model eGestion360Web.Pages.Catalogos.TiposCambio.IndexModel
@{
    ViewData["Title"] = "Tipos de cambio";
    var ultima = Model.UltimaEjecucion;
}

@section Head {
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/tasas-cambio.css" asp-append-version="true" />
}

<div class="tc-page">
    <partial name="_TasasEncabezado" model="@(new TasasEncabezado("Tipos de cambio", Model.EsAdminSistema))" />

    <div class="tc-head">
        <div>
            <h1 class="tc-title">Tipos de cambio</h1>
            <p class="tc-sub">Dólar y euro en lempiras: tasas oficiales del BCH y tasas propias de cada empresa.</p>
        </div>
        @if (Model.JobHabilitado)
        {
            <div class="tc-status" role="status">
                <span class="tc-dot @(ultima?.Estado == "FALLIDA" ? "tc-dot-bad" : "tc-dot-ok")" aria-hidden="true"></span>
                <div>
                    <strong>Job automático activo</strong>
                    <small>
                        @if (ultima != null)
                        {
                            @($"Última ejecución {Model.HoraHonduras(ultima.InicioUtc)} · {FormatoTasas.NombreEstadoEjecucion(ultima.Estado).ToLowerInvariant()}")
                        }
                        else
                        {
                            @("Todavía no hay ejecuciones")
                        }
                    </small>
                </div>
            </div>
        }
        else
        {
            <div class="tc-status" role="status">
                <span class="tc-dot" aria-hidden="true"></span>
                <div>
                    <strong>Job automático apagado</strong>
                    <small>
                        @if (Model.EsAdminSistema)
                        {
                            <a asp-page="Configuracion">Habilitarlo en Configuración</a>
                        }
                        else
                        {
                            @("Las tasas oficiales no se buscan solas")
                        }
                    </small>
                </div>
            </div>
        }
    </div>

    @if (TempData[IndexModel.ClaveMensaje] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData[IndexModel.ClaveMensaje]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    @if (TempData[IndexModel.ClaveError] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="fas fa-times-circle me-2"></i>@TempData[IndexModel.ClaveError]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    @if (Model.AvisoBaseDatos != null)
    {
        <div class="alert alert-warning d-flex align-items-start" role="alert">
            <i class="fas fa-database fa-lg me-3 mt-1"></i>
            <div>
                <strong>@Model.AvisoBaseDatos</strong>
                @if (Model.ModuloNoInstalado)
                {
                    <div class="small mt-1">
                        Las tablas de tasas de cambio y su bitácora todavía no existen en esta base de datos. El script
                        <code>020_tasas_cambio_v2.sql</code> se aplica en la puesta en marcha
                        (<code>1 - Documetacion/TASAS_CAMBIO.md</code>, sección 12).
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <partial name="_TasasVigentes" model="Model" />
        <div class="mt-4"><partial name="_TasasPendientes" model="Model" /></div>
        <partial name="_TasasAcciones" model="Model" />
    }
</div>
