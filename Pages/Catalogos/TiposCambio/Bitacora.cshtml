@page
@model eGestion360Web.Pages.Catalogos.TiposCambio.BitacoraModel
@{
    ViewData["Title"] = "Bitácora del job de tasas de cambio";
    var total = Model.Ejecuciones.Count;
    var exitosas = Model.Ejecuciones.Count(e => e.Estado == "EXITOSA");
    var omitidas = Model.Ejecuciones.Count(e => e.Estado.StartsWith("OMITIDA"));
    var fallidas = Model.Ejecuciones.Count(e => e.Estado == "FALLIDA");
}

@section Head {
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/tasas-cambio.css" asp-append-version="true" />
}

<div class="tc-page">
    <partial name="_TasasEncabezado" model="@(new TasasEncabezado("Bitácora del job", Model.EsAdminSistema))" />

    <div class="tc-head">
        <div>
            <h1 class="tc-title">Bitácora del job</h1>
            <p class="tc-sub">Cada vez que el job busca las tasas deja una fila: qué fecha buscaba, quién lo disparó, cómo terminó y cuántas tasas leyó.</p>
        </div>
    </div>

    @if (TempData[IndexModel.ClaveMensaje] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData[IndexModel.ClaveMensaje]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    @if (Model.AvisoBaseDatos != null)
    {
        <div class="alert alert-warning d-flex align-items-start" role="alert">
            <i class="fas fa-database fa-lg me-3 mt-1"></i>
            <div><strong>@Model.AvisoBaseDatos</strong></div>
        </div>
    }

    <div class="tc-tiles">
        <div class="tc-tile"><div class="tc-tile-label">Ejecuciones mostradas</div><div class="tc-tile-num">@total</div></div>
        <div class="tc-tile"><div class="tc-tile-label">Exitosas</div><div class="tc-tile-num">@exitosas</div></div>
        <div class="tc-tile"><div class="tc-tile-label">Omitidas</div><div class="tc-tile-num">@omitidas</div></div>
        <div class="tc-tile"><div class="tc-tile-label">Fallidas</div><div class="tc-tile-num">@fallidas</div></div>
    </div>


<div class="card border-0 shadow-sm mb-4" id="bitacora">
    <div class="card-header bg-light d-flex justify-content-between align-items-center">
        <strong><i class="fas fa-clipboard-list me-2"></i>Bitácora del job</strong>
        <small class="text-muted">Últimas @BitacoraModel.MaxEjecuciones ejecuciones · horas de Honduras</small>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table mb-0 align-middle small">
                <thead class="table-light">
                    <tr>
                        <th>#</th>
                        <th>Fecha objetivo</th>
                        <th>Disparador</th>
                        <th class="text-center">Intento</th>
                        <th>Estado</th>
                        <th class="text-center text-nowrap" title="Leídos / nuevos / reemplazados / duplicados / inválidos o en revisión">L / N / R / D / I</th>
                        <th>Mensaje</th>
                        <th class="text-nowrap">Inicio → fin</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Ejecuciones.Any())
                    {
                        <tr>
                            <td colspan="9" class="text-center text-muted py-4">
                                <i class="fas fa-inbox fa-2x mb-2 d-block"></i>
                                Todavía no hay ejecuciones del job.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var e in Model.Ejecuciones)
                        {
                            var idDetalle = $"ejecucion-{e.IdEjecucion}";
                            var segundos = e.FinUtc is { } fin ? (int)Math.Round((fin - e.InicioUtc).TotalSeconds) : (int?)null;
                            <tr>
                                <td><code>@e.IdEjecucion</code></td>
                                <td>@FormatoTasas.Fecha(e.FechaObjetivo)</td>
                                <td>@FormatoTasas.NombreDisparador(e.Disparador)</td>
                                <td class="text-center">@e.Intento</td>
                                <td><span class="badge @FormatoTasas.ClaseEstadoEjecucion(e.Estado)" title="@e.Estado">@FormatoTasas.NombreEstadoEjecucion(e.Estado)</span></td>
                                <td class="text-center text-nowrap">
                                    <span title="Leídos">@e.Leidos</span> /
                                    <span title="Nuevos">@e.Insertados</span> /
                                    <span title="Reemplazados">@e.Reemplazados</span> /
                                    <span title="Duplicados">@e.Duplicados</span> /
                                    <span title="Inválidos o en revisión">@e.Invalidos</span>
                                </td>
                                <td style="min-width: 14rem; max-width: 24rem;">@(e.Mensaje ?? "—")</td>
                                <td class="text-nowrap">
                                    @Model.HoraHonduras(e.InicioUtc)
                                    <div class="text-muted">
                                        @if (segundos != null)
                                        {
                                            @($"→ {Model.FinHonduras(e.InicioUtc, e.FinUtc)} · {segundos} s")
                                        }
                                        else
                                        {
                                            @("sin terminar")
                                        }
                                    </div>
                                </td>
                                <td class="text-end">
                                    <button type="button" class="btn btn-sm btn-outline-secondary text-nowrap" data-bs-toggle="collapse"
                                            data-bs-target="#@idDetalle" aria-expanded="false" aria-controls="@idDetalle">
                                        <i class="fas fa-list me-1"></i>Detalle (@e.Detalles.Count)
                                    </button>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="9" class="p-0 border-0">
                                    <div class="collapse" id="@idDetalle">
                                        <div class="bg-light p-3 border-bottom">
                                            <div class="row g-2 mb-2">
                                                <div class="col-md-3"><span class="text-muted">Fuente:</span> @FormatoTasas.NombreFuente(e.Fuente)</div>
                                                <div class="col-md-3"><span class="text-muted">Ejecutado por:</span> @e.EjecutadoPor</div>
                                                <div class="col-md-3"><span class="text-muted">Próximo intento:</span> @Model.HoraHonduras(e.ProximoIntentoUtc)</div>
                                                @if (e.IdEjecucionOrigen != null)
                                                {
                                                    <div class="col-md-3"><span class="text-muted">Reintento de:</span> @("#" + e.IdEjecucionOrigen)</div>
                                                }
                                                @if (Model.EsAdminSistema)
                                                {
                                                    <div class="col-md-3"><span class="text-muted">HTTP:</span> @(e.HttpStatus?.ToString() ?? "—")</div>
                                                    <div class="col-md-3"><span class="text-muted">Servidor:</span> @e.Servidor</div>
                                                    <div class="col-md-3"><span class="text-muted">Alerta atendida:</span> @(e.Notificado ? "Sí" : "No")</div>
                                                    <div class="col-12 text-break"><span class="text-muted">Endpoint:</span> <code>@(e.Endpoint ?? "—")</code></div>
                                                    @if (!string.IsNullOrWhiteSpace(e.DetalleError))
                                                    {
                                                        <div class="col-12">
                                                            <span class="text-muted">Detalle del error:</span>
                                                            <pre class="small bg-white border rounded p-2 mb-0 text-wrap">@e.DetalleError</pre>
                                                        </div>
                                                    }
                                                }
                                            </div>
                                            @if (!e.Detalles.Any())
                                            {
                                                <div class="text-muted">Sin detalle por moneda.</div>
                                            }
                                            else
                                            {
                                                <table class="table table-sm table-bordered bg-white mb-0">
                                                    <thead class="table-light">
                                                        <tr>
                                                            <th>Fecha</th>
                                                            <th>Moneda</th>
                                                            <th>Tipo</th>
                                                            <th class="text-end">Valor leído</th>
                                                            <th>Resultado</th>
                                                            <th>Motivo</th>
                                                            <th class="text-center">Tasa</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var d in e.Detalles)
                                                        {
                                                            <tr>
                                                                <td>@FormatoTasas.Fecha(d.FechaVigencia)</td>
                                                                <td>@d.MonedaOrigen → @d.MonedaDestino</td>
                                                                <td>@FormatoTasas.NombreTipo(d.TipoTasa)</td>
                                                                <td class="text-end text-nowrap">@(d.ValorLeido is { } v ? FormatoTasas.Tasa(v) : "—")</td>
                                                                <td><span class="badge @FormatoTasas.ClaseResultadoDetalle(d.Resultado)">@d.Resultado</span></td>
                                                                <td>@(d.Motivo ?? "—")</td>
                                                                <td class="text-center">@(d.IdTasaCambio is { } id ? $"#{id}" : "—")</td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </table>
                                            }
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
</div>
