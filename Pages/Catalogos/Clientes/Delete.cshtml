@page "{id:int}"
@model eGestion360Web.Pages.Catalogos.Clientes.DeleteModel
@{
    ViewData["Title"] = "Eliminar Cliente";
}

<div class="container">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="/MainMenu">Menú Principal</a></li>
            <li class="breadcrumb-item"><a asp-page="/Catalogos/Index">Catálogos</a></li>
            <li class="breadcrumb-item"><a asp-page="Index">Clientes</a></li>
            <li class="breadcrumb-item active" aria-current="page">Eliminar</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-start mb-4">
        <h2 class="mb-0 text-danger"><i class="fas fa-trash me-2"></i>Eliminar Cliente</h2>
        <a asp-page="Index" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-2"></i>Volver
        </a>
    </div>

    @if (Model.Cliente != null)
    {
        <div class="alert alert-warning">
            <i class="fas fa-exclamation-triangle me-2"></i>
            ¿Está seguro que desea eliminar al cliente <strong>@Model.Cliente.RazonSocial</strong>?
            Esta acción marcará el registro como eliminado (soft delete) y no podrá usarse en operaciones nuevas.
        </div>

        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-3">Código</dt><dd class="col-sm-9"><code>@Model.Cliente.Codigo</code></dd>
                    <dt class="col-sm-3">Razón social</dt><dd class="col-sm-9">@Model.Cliente.RazonSocial</dd>
                    <dt class="col-sm-3">RTN</dt><dd class="col-sm-9">@Model.Cliente.IdentificadorFiscal</dd>
                    <dt class="col-sm-3">Teléfono</dt><dd class="col-sm-9">@Model.Cliente.Telefono</dd>
                    <dt class="col-sm-3">Email</dt><dd class="col-sm-9">@Model.Cliente.Email</dd>
                </dl>
            </div>
        </div>

        <form method="post">
            <div class="d-flex justify-content-end gap-2">
                <a asp-page="Index" class="btn btn-outline-secondary">Cancelar</a>
                <button type="submit" class="btn btn-danger">
                    <i class="fas fa-trash me-2"></i>Eliminar
                </button>
            </div>
        </form>
    }
</div>
