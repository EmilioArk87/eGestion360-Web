@page "{id:int}"
@model eGestion360Web.Pages.Catalogos.Clientes.EditModel
@{
    ViewData["Title"] = "Editar Cliente";
}

<div class="container">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="/MainMenu">Menú Principal</a></li>
            <li class="breadcrumb-item"><a asp-page="/Catalogos/Index">Catálogos</a></li>
            <li class="breadcrumb-item"><a asp-page="Index">Clientes</a></li>
            <li class="breadcrumb-item active" aria-current="page">Editar</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-start mb-4">
        <h2 class="mb-0"><i class="fas fa-user-edit me-2"></i>Editar Cliente</h2>
        <a asp-page="Index" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-2"></i>Volver
        </a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input type="hidden" asp-for="Cliente.IdCliente" />
                <input type="hidden" asp-for="Cliente.TokenConcurrencia" />

                @if (Model.Enlazado && Model.Persona != null)
                {
                    <div class="border rounded p-3 mb-4 bg-light">
                        <h6 class="fw-semibold mb-2"><i class="fas fa-id-card me-2"></i>Persona</h6>
                        <div class="small">
                            @if (!string.IsNullOrEmpty(Model.Persona.Numero))
                            {
                                <span class="badge bg-light text-dark border me-1">@Model.Persona.TipoDocumento</span>
                                <span class="me-2">@eGestion360Web.Services.Personas.DocumentosIdentidad.Enmascarar(Model.Persona.Numero)</span>
                            }
                            else
                            {
                                <span class="text-muted me-2">Sin documento</span>
                            }
                            @if (Model.Persona.EstadoIdentidad == "verificada")
                            {
                                <span class="badge bg-success me-2"><i class="fas fa-check-circle me-1"></i>Identidad verificada</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary me-2"><i class="fas fa-hourglass-half me-1"></i>Identidad pendiente</span>
                            }
                            @if (Model.Persona.Desde.HasValue)
                            {
                                <span class="text-muted">Cliente desde @Model.Persona.Desde.Value.ToString("dd/MM/yyyy")</span>
                            }
                            @if (Model.Persona.Hasta.HasValue)
                            {
                                <span class="text-muted ms-2">· Dado de baja el @Model.Persona.Hasta.Value.ToString("dd/MM/yyyy")@(string.IsNullOrEmpty(Model.Persona.Motivo) ? "" : $" ({Model.Persona.Motivo})")</span>
                            }
                        </div>
                        <div class="small text-muted mt-2">
                            Este cliente comparte su ficha de persona con el resto del sistema. Aquí solo se cambian sus datos comerciales.
                            Desactivarlo da de baja su relación como cliente; activarlo la reabre.
                        </div>
                    </div>
                }

                <partial name="_ClienteForm" model="Model.Cliente"
                         view-data="@(new ViewDataDictionary(ViewData) { TemplateInfo = { HtmlFieldPrefix = nameof(Model.Cliente) } })" />
                <hr class="my-4" />
                <div class="d-flex justify-content-end gap-2">
                    <a asp-page="Index" class="btn btn-outline-secondary">Cancelar</a>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-2"></i>Guardar cambios
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
