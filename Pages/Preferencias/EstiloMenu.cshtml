@page
@model eGestion360Web.Pages.Preferencias.EstiloMenuModel
@using eGestion360Web.Models.Plataforma
@{
    ViewData["Title"] = "Estilo de menú";
}

<div class="container" style="max-width: 980px;">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="/MainMenu">Menú Principal</a></li>
            <li class="breadcrumb-item active" aria-current="page">Perfil y preferencias</li>
        </ol>
    </nav>

    <div class="mb-4">
        <h2 class="mb-1"><i class="fas fa-palette me-2"></i>Estilo de menú</h2>
        <p class="text-muted mb-0">Elige cómo quieres navegar. El cambio aplica al instante y se guarda en tu cuenta, así que lo verás igual en cualquier equipo y sitio.</p>
    </div>

    @if (Model.Mensaje != null)
    {
        <div class="alert alert-success"><i class="fas fa-check-circle me-2"></i>@Model.Mensaje</div>
    }
    @if (Model.Error != null)
    {
        <div class="alert alert-danger"><i class="fas fa-exclamation-triangle me-2"></i>@Model.Error</div>
    }

    <div class="row g-3">
        @foreach (var estilo in EstilosDeMenu.Todos)
        {
            var activo = estilo == Model.EstiloActual;
            <div class="col-md-4">
                <form method="post" class="h-100">
                    <input type="hidden" name="Estilo" value="@estilo" />
                    <button type="submit" class="egm-opcion-estilo @(activo ? "activo" : "")" aria-pressed="@(activo ? "true" : "false")">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <span class="egm-tarjeta-ico"><i class="fas @EstilosDeMenu.Icono(estilo)"></i></span>
                            <div>
                                <strong>@EstilosDeMenu.Nombre(estilo)</strong>
                                @if (estilo == EstilosDeMenu.Hub)
                                {
                                    <div class="small text-muted">Predeterminado</div>
                                }
                            </div>
                            @if (activo)
                            {
                                <span class="badge bg-primary ms-auto"><i class="fas fa-check me-1"></i>En uso</span>
                            }
                        </div>
                        <div class="small text-muted">@EstilosDeMenu.Descripcion(estilo)</div>
                    </button>
                </form>
            </div>
        }
    </div>

    <p class="small text-muted mt-4 mb-0">
        <i class="fas fa-keyboard me-1"></i>En cualquier estilo puedes presionar <kbd>Ctrl</kbd>+<kbd>K</kbd> para ir directo a cualquier pantalla que puedas abrir.
    </p>
</div>
