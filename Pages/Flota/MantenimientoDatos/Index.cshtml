@page
@model eGestion360Web.Pages.Flota.MantenimientoDatos.IndexModel
@{
    ViewData["Title"] = "Mantenimiento de Datos - Flota";
}

<div class="container">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="/MainMenu">Menú Principal</a></li>
            <li class="breadcrumb-item"><a asp-page="/Flota/Index">Flota & KPIs</a></li>
            <li class="breadcrumb-item active">Mantenimiento de Datos</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <h2 class="mb-1">
                <i class="fas fa-sliders-h me-2" style="color:#fd7e14;"></i>Mantenimiento de Datos
            </h2>
            <p class="text-muted mb-0">Gestión de tablas de apoyo del módulo de flota</p>
        </div>
        <a asp-page="/Flota/Index" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-2"></i>Volver
        </a>
    </div>

    <div class="row g-4">

        <!-- Tipos de Vehículo -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm border-0 menu-card">
                <div class="card-body text-center p-4">
                    <div class="menu-icon text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                         style="width: 4rem; height: 4rem; background-color: #fd7e14;">
                        <i class="fas fa-tags fa-lg"></i>
                    </div>
                    <h6 class="card-title fw-bold mb-2">Tipos de Vehículo</h6>
                    <p class="card-text text-muted small mb-3">Bus, camión, pick-up, auto, etc.</p>
                    <a asp-page="/Flota/Catalogos/TiposVehiculo/Index" class="btn btn-sm w-100 text-white" style="background-color:#fd7e14;">
                        <i class="fas fa-arrow-right me-1"></i>Gestionar
                    </a>
                </div>
            </div>
        </div>

        <!-- Rutas -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm border-0 menu-card">
                <div class="card-body text-center p-4">
                    <div class="menu-icon text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                         style="width: 4rem; height: 4rem; background-color: #fd7e14;">
                        <i class="fas fa-route fa-lg"></i>
                    </div>
                    <h6 class="card-title fw-bold mb-2">Rutas</h6>
                    <p class="card-text text-muted small mb-3">Rutas o zonas de operación</p>
                    <a asp-page="/Flota/Catalogos/Rutas/Index" class="btn btn-sm w-100 text-white" style="background-color:#fd7e14;">
                        <i class="fas fa-arrow-right me-1"></i>Gestionar
                    </a>
                </div>
            </div>
        </div>

        <!-- Talleres -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm border-0 menu-card">
                <div class="card-body text-center p-4">
                    <div class="menu-icon text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                         style="width: 4rem; height: 4rem; background-color: #fd7e14;">
                        <i class="fas fa-wrench fa-lg"></i>
                    </div>
                    <h6 class="card-title fw-bold mb-2">Talleres</h6>
                    <p class="card-text text-muted small mb-3">Proveedores de mantenimiento</p>
                    <a asp-page="/Flota/Catalogos/Talleres/Index" class="btn btn-sm w-100 text-white" style="background-color:#fd7e14;">
                        <i class="fas fa-arrow-right me-1"></i>Gestionar
                    </a>
                </div>
            </div>
        </div>

        <!-- Categorías de Repuesto -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm border-0 menu-card">
                <div class="card-body text-center p-4">
                    <div class="menu-icon text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                         style="width: 4rem; height: 4rem; background-color: #fd7e14;">
                        <i class="fas fa-cogs fa-lg"></i>
                    </div>
                    <h6 class="card-title fw-bold mb-2">Categorías de Repuesto</h6>
                    <p class="card-text text-muted small mb-3">Clasificación de repuestos y llantas por empresa</p>
                    <a asp-page="/Flota/Catalogos/CategoriasRepuesto/Index" class="btn btn-sm w-100 text-white" style="background-color:#fd7e14;">
                        <i class="fas fa-arrow-right me-1"></i>Gestionar
                    </a>
                </div>
            </div>
        </div>

        <!-- Cargos -->
        <div class="col-md-6 col-lg-4">
            <div class="card h-100 shadow-sm border-0 menu-card">
                <div class="card-body text-center p-4">
                    <div class="menu-icon text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3"
                         style="width: 4rem; height: 4rem; background-color: #fd7e14;">
                        <i class="fas fa-user-tag fa-lg"></i>
                    </div>
                    <h6 class="card-title fw-bold mb-2">Cargos</h6>
                    <p class="card-text text-muted small mb-3">Cargos del personal de flota</p>
                    <a asp-page="/Flota/Catalogos/Cargos/Index" class="btn btn-sm w-100 text-white" style="background-color:#fd7e14;">
                        <i class="fas fa-arrow-right me-1"></i>Gestionar
                    </a>
                </div>
            </div>
        </div>

    </div>
</div>

@section Scripts {
    <style>
        .menu-card { transition: transform 0.2s ease, box-shadow 0.2s ease; }
        .menu-card:hover { transform: translateY(-4px); box-shadow: 0 0.4rem 1rem rgba(0,0,0,.12) !important; }
    </style>
}
