@page
@model eGestion360Web.Pages.Flota.Catalogos.Personas.IndexModel
@using eGestion360Web.Models.Personas
@using eGestion360Web.Services.Personas
@{
    ViewData["Title"] = "Personal";
    var hayFiltros = !string.IsNullOrWhiteSpace(Model.Search) || !string.IsNullOrWhiteSpace(Model.FiltroCargo)
                     || !string.IsNullOrWhiteSpace(Model.FiltroEstado) || !string.IsNullOrWhiteSpace(Model.FiltroPerfil);
}

<div class="container">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="/MainMenu">Menú Principal</a></li>
            <li class="breadcrumb-item"><a asp-page="/Flota/Index">Flota</a></li>
            <li class="breadcrumb-item"><a asp-page="/Flota/Catalogos/Index">Catálogos</a></li>
            <li class="breadcrumb-item active">Personal</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <h2 class="mb-1"><i class="fas fa-id-badge me-2" style="color:#0d6efd;"></i>Personal</h2>
            <p class="text-muted mb-0">Conductores, cobradores, mecánicos y supervisores de la empresa</p>
        </div>
        <div class="d-flex gap-2">
            @if (Model.MensajeBloqueo == null && Model.PuedeCrear)
            {
                <a asp-page="Create" class="btn btn-primary">
                    <i class="fas fa-user-plus me-2"></i>Nuevo registro
                </a>
            }
            <a asp-page="/Flota/Catalogos/Index" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-2"></i>Volver
            </a>
        </div>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle me-2"></i>@TempData["Mensaje"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Avisos"] != null)
    {
        <div class="alert alert-warning alert-dismissible fade show">
            <i class="fas fa-exclamation-triangle me-2"></i>@TempData["Avisos"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="fas fa-times-circle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model.MensajeBloqueo != null)
    {
        <div class="alert alert-warning">
            <i class="fas fa-lock me-2"></i>@Model.MensajeBloqueo
        </div>
    }
    else
    {
        @if (Model.NombresPorRevisar > 0 && Model.FiltroPerfil != "nombres")
        {
            <div class="alert alert-warning d-flex justify-content-between align-items-center">
                <div>
                    <i class="fas fa-exclamation-triangle me-2"></i>
                    <strong>@Model.NombresPorRevisar @(Model.NombresPorRevisar == 1 ? "persona tiene" : "personas tienen") el nombre por revisar.</strong>
                    Vienen de una carga antigua y hay que indicar cuál es su primer nombre y su primer apellido.
                </div>
                <a asp-page="Index" asp-route-FiltroPerfil="nombres" class="btn btn-sm btn-warning ms-3 text-nowrap">Ver la lista</a>
            </div>
        }

        <!-- Filtros -->
        <form method="get" class="card border-0 shadow-sm mb-3">
            <div class="card-body">
                <div class="row g-2 align-items-end">
                    <div class="col">
                        <div class="input-group">
                            <span class="input-group-text"><i class="fas fa-search"></i></span>
                            <input asp-for="Search" class="form-control"
                                   placeholder="Buscar por nombre, código de empleado o documento..." />
                        </div>
                    </div>
                    <div class="col-auto">
                        <select asp-for="FiltroCargo" class="form-select">
                            <option value="">— Todos los cargos —</option>
                            @foreach (var c in Model.Cargos)
                            {
                                <option value="@c.Valor" selected="@(Model.FiltroCargo == c.Valor)">@c.Texto</option>
                            }
                        </select>
                    </div>
                    <div class="col-auto">
                        <select asp-for="FiltroEstado" class="form-select">
                            <option value="">— Todos —</option>
                            <option value="1">Activos</option>
                            <option value="0">Inactivos</option>
                        </select>
                    </div>
                    <div class="col-auto">
                        <select asp-for="FiltroPerfil" class="form-select">
                            <option value="">— Todos los perfiles —</option>
                            <option value="incompleto">Perfil incompleto</option>
                            <option value="nombres">Nombre por revisar</option>
                        </select>
                    </div>
                    <div class="col-auto">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-search me-1"></i>Buscar
                        </button>
                        @if (hayFiltros)
                        {
                            <a asp-page="Index" class="btn btn-outline-secondary ms-1" title="Quitar los filtros">
                                <i class="fas fa-times"></i>
                            </a>
                        }
                    </div>
                </div>
            </div>
        </form>

        <!-- Tabla -->
        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0 align-middle paginated-table" data-page-size="15">
                        <thead class="table-light">
                            <tr>
                                <th>Nombre completo</th>
                                <th>Documento</th>
                                <th>Código</th>
                                <th class="text-center">Cargo</th>
                                <th>Teléfono</th>
                                <th>Tarifa diaria</th>
                                <th>Ingreso</th>
                                <th class="text-center">Estado</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.Personas.Any())
                            {
                                <tr>
                                    <td colspan="9" class="text-center text-muted py-5">
                                        <i class="fas fa-users fa-2x mb-2 d-block text-secondary"></i>
                                        @(hayFiltros ? "Ninguna persona coincide con los filtros." : "No hay personal registrado.")
                                    </td>
                                </tr>
                            }
                            else
                            {
                                foreach (var p in Model.Personas)
                                {
                                    var partes = p.NombreCompleto.Split(", ", 2);
                                    var iniciales = (partes[0].Length > 0 ? partes[0][..1] : "") + (partes.Length > 1 && partes[1].Length > 0 ? partes[1][..1] : "");
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center fw-bold"
                                                     style="width:2rem;height:2rem;min-width:2rem;font-size:.75rem;">
                                                    @iniciales.ToUpper()
                                                </div>
                                                <div>
                                                    <a asp-page="Edit" asp-route-id="@p.IdPersona" class="text-decoration-none text-reset">
                                                        <strong>@partes[0]</strong>@(partes.Length > 1 ? ", " + partes[1] : "")
                                                    </a>
                                                    <div>
                                                        @if (p.EstadoIdentidad == EstadosIdentidad.Verificada)
                                                        {
                                                            <span class="badge bg-success" title="Tiene un documento de identidad registrado"><i class="fas fa-check-circle me-1"></i>Verificada</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-secondary" title="Todavía no tiene un documento de identidad registrado"><i class="fas fa-hourglass-half me-1"></i>Pendiente</span>
                                                        }
                                                        @if (p.PerfilIncompleto)
                                                        {
                                                            <span class="badge bg-warning text-dark"
                                                                  title="Falta: @string.Join(", ", p.Faltantes)">
                                                                <i class="fas fa-exclamation-circle me-1"></i>Perfil incompleto
                                                            </span>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-muted small text-nowrap">
                                            @if (!string.IsNullOrEmpty(p.Documento))
                                            {
                                                <span class="badge bg-light text-dark border me-1">@p.TipoDocumento</span>
                                                <span>@DocumentosIdentidad.Enmascarar(p.Documento)</span>
                                            }
                                            else
                                            {
                                                <span>Sin documento</span>
                                            }
                                        </td>
                                        <td class="text-muted small">@(p.CodigoInterno ?? "—")</td>
                                        <td class="text-center">
                                            @{
                                                var (badgeColor, cargoLabel) = p.Cargo switch
                                                {
                                                    "CONDUCTOR" => ("bg-primary", "Conductor"),
                                                    "COBRADOR" => ("bg-info", "Cobrador"),
                                                    "MECANICO" => ("bg-warning text-dark", "Mecánico"),
                                                    "SUPERVISOR" => ("bg-success", "Supervisor"),
                                                    "OTRO" => ("bg-secondary", "Otro"),
                                                    null => ("bg-light text-dark border", "—"),
                                                    _ => ("bg-secondary", p.Cargo)
                                                };
                                            }
                                            <span class="badge @badgeColor">@cargoLabel</span>
                                        </td>
                                        <td class="text-nowrap">@(string.IsNullOrEmpty(p.Telefono) ? "—" : ContactoPersona.FormatearTelefono(p.Telefono))</td>
                                        <td class="text-nowrap">
                                            @if (p.TarifaDiaria.HasValue)
                                            {
                                                <span>@p.TarifaDiaria.Value.ToString("N2") @p.Moneda</span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                        <td class="text-muted small">@(p.FechaIngreso?.ToString("dd/MM/yyyy") ?? "—")</td>
                                        <td class="text-center">
                                            <span class="badge @(p.Activo ? "bg-success" : "bg-secondary")">@(p.Activo ? "Activo" : "Inactivo")</span>
                                        </td>
                                        <td class="text-end text-nowrap">
                                            @if (Model.PuedeEditar)
                                            {
                                                <a asp-page="Edit" asp-route-id="@p.IdPersona" class="btn btn-sm btn-outline-primary" title="Editar">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                            }
                                            <a asp-page="Historial" asp-route-id="@p.IdPersona" class="btn btn-sm btn-outline-secondary" title="Historial de cambios">
                                                <i class="fas fa-history"></i>
                                            </a>
                                            @if (Model.PuedeEditar)
                                            {
                                                <form method="post" asp-page-handler="Toggle" class="d-inline">
                                                    <input type="hidden" name="id" value="@p.IdPersona" />
                                                    <input type="hidden" name="activo" value="@((!p.Activo).ToString().ToLower())" />
                                                    <input type="hidden" name="Search" value="@Model.Search" />
                                                    <input type="hidden" name="FiltroCargo" value="@Model.FiltroCargo" />
                                                    <input type="hidden" name="FiltroEstado" value="@Model.FiltroEstado" />
                                                    <input type="hidden" name="FiltroPerfil" value="@Model.FiltroPerfil" />
                                                    <button type="submit"
                                                            class="btn btn-sm @(p.Activo ? "btn-outline-danger" : "btn-outline-success")"
                                                            title="@(p.Activo ? "Desactivar" : "Activar")">
                                                        <i class="fas @(p.Activo ? "fa-user-slash" : "fa-user-check")"></i>
                                                    </button>
                                                </form>
                                            }
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            @if (Model.Personas.Any())
            {
                <div class="card-footer bg-white text-muted small py-2 px-3">
                    @Model.Personas.Count registro(s) encontrado(s)
                </div>
            }
        </div>
    }
</div>
