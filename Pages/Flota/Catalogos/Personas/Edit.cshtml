@page "{id:int}"
@model eGestion360Web.Pages.Flota.Catalogos.Personas.EditModel
@using eGestion360Web.Models.Personas
@{
    ViewData["Title"] = "Editar personal";
    var edicion = Model.Edicion;
}

<div class="container">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="/MainMenu">Menú Principal</a></li>
            <li class="breadcrumb-item"><a asp-page="/Flota/Catalogos/Index">Catálogos</a></li>
            <li class="breadcrumb-item"><a asp-page="Index">Personal</a></li>
            <li class="breadcrumb-item active">Editar</li>
        </ol>
    </nav>

    <div class="d-flex align-items-start justify-content-between mb-4">
        <div class="d-flex align-items-center">
            <div class="me-3 bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center"
                 style="width:3rem;height:3rem;min-width:3rem;">
                <i class="fas fa-user-edit"></i>
            </div>
            <div>
                <h2 class="mb-0">Editar personal</h2>
                @if (edicion != null)
                {
                    <p class="text-muted mb-0">
                        @if (edicion.EstadoIdentidad == EstadosIdentidad.Verificada)
                        {
                            <span class="badge bg-success me-1"><i class="fas fa-check-circle me-1"></i>Identidad verificada</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary me-1" title="Todavía no tiene un documento de identidad registrado"><i class="fas fa-hourglass-half me-1"></i>Identidad pendiente</span>
                        }
                        <span class="badge @(edicion.Activo ? "bg-success" : "bg-secondary") me-1">@(edicion.Activo ? "Activo" : "Inactivo")</span>
                        <span class="small">
                            Registrado por @edicion.CreadoPor el @edicion.FechaCreacion.AddHours(-6).ToString("dd/MM/yyyy")
                            @if (edicion.FechaModificacion.HasValue)
                            {
                                <text>· Última modificación por @(edicion.ModificadoPor ?? "—") el @edicion.FechaModificacion.Value.AddHours(-6).ToString("dd/MM/yyyy HH:mm")</text>
                            }
                        </span>
                    </p>
                }
            </div>
        </div>
        @if (Model.MensajeBloqueo == null)
        {
            <a asp-page="Historial" asp-route-id="@Model.IdPersona" class="btn btn-outline-secondary">
                <i class="fas fa-history me-2"></i>Historial
            </a>
        }
    </div>

    @if (Model.MensajeBloqueo != null)
    {
        <div class="alert alert-warning">
            <i class="fas fa-lock me-2"></i>@Model.MensajeBloqueo
        </div>
        <a asp-page="Index" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-2"></i>Volver</a>
    }
    else
    {
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <form method="post" id="form-persona" novalidate>
                    <input type="hidden" asp-for="TokenConcurrencia" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small"></div>

                    @if (Model.OfreceFusion)
                    {
                        <div class="card border-warning shadow-sm mb-3">
                            <div class="card-header bg-warning bg-opacity-25 fw-semibold">
                                <i class="fas fa-code-merge me-2"></i>Este documento ya está registrado
                            </div>
                            <div class="card-body">
                                <p class="mb-2">
                                    El documento que escribiste ya pertenece a una persona registrada en el sistema, y los datos que
                                    escribiste coinciden con ella. Si es la misma persona, puedes <strong>fusionar</strong> las dos fichas:
                                    esta ficha pasa a ser parte de la que ya existía, con todo su historial de trabajo.
                                </p>
                                <p class="small text-muted">
                                    Mientras no confirmes, no se guarda ningún cambio. Si no es la misma persona, revisa el documento.
                                </p>
                                <button type="submit" name="ConfirmarFusion" value="true" class="btn btn-warning">
                                    <i class="fas fa-code-merge me-2"></i>Sí, es la misma persona: fusionar
                                </button>
                            </div>
                        </div>
                    }

                    <partial name="_PersonaFormulario" model="Model.Vista" />

                    <div class="d-flex gap-2 mb-4">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save me-2"></i>Guardar cambios
                        </button>
                        <a asp-page="Index" class="btn btn-outline-secondary">
                            <i class="fas fa-times me-2"></i>Cancelar
                        </a>
                    </div>
                </form>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="~/js/personas-form.js" asp-append-version="true"></script>
}
