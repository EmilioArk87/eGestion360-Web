@page
@model eGestion360Web.Pages.Flota.Catalogos.Personas.CreateModel
@{
    ViewData["Title"] = "Nuevo personal";
}

<div class="container">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="/MainMenu">Menú Principal</a></li>
            <li class="breadcrumb-item"><a asp-page="/Flota/Catalogos/Index">Catálogos</a></li>
            <li class="breadcrumb-item"><a asp-page="Index">Personal</a></li>
            <li class="breadcrumb-item active">Nuevo</li>
        </ol>
    </nav>

    <div class="d-flex align-items-center mb-4">
        <div class="me-3 bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center"
             style="width:3rem;height:3rem;min-width:3rem;">
            <i class="fas fa-user-plus"></i>
        </div>
        <div>
            <h2 class="mb-0">Nuevo registro de personal</h2>
            <p class="text-muted mb-0">Completa los datos de la persona y su cargo en la empresa</p>
        </div>
    </div>

    @if (Model.MensajeBloqueo != null)
    {
        <div class="alert alert-warning">
            <i class="fas fa-lock me-2"></i>@Model.MensajeBloqueo
        </div>
        <a asp-page="Index" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-2"></i>Volver</a>
    }
    else
    {
        <div class="row justify-content-center">
            <div class="col-lg-10">
                <form method="post" id="form-persona" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger small"></div>

                    @if (Model.Parecidas.Any())
                    {
                        <div class="card border-warning shadow-sm mb-3">
                            <div class="card-header bg-warning bg-opacity-25 fw-semibold">
                                <i class="fas fa-users me-2"></i>¿Ya está registrada esta persona?
                            </div>
                            <div class="card-body">
                                <p class="mb-2">
                                    En esta empresa hay @(Model.Parecidas.Count == 1 ? "una persona" : $"{Model.Parecidas.Count} personas")
                                    con el mismo nombre. Revisa si es la misma antes de registrarla otra vez.
                                </p>
                                <table class="table table-sm align-middle mb-3">
                                    <thead class="table-light">
                                        <tr><th>Nombre</th><th>Nacimiento</th><th>Estado</th><th></th></tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var p in Model.Parecidas)
                                        {
                                            <tr>
                                                <td>@p.NombreCompleto</td>
                                                <td>@(p.FechaNacimiento?.ToString("dd/MM/yyyy") ?? "—")</td>
                                                <td><span class="badge @(p.Activa ? "bg-success" : "bg-secondary")">@(p.Activa ? "Activo" : "Inactivo")</span></td>
                                                <td class="text-end">
                                                    @if (p.EsPersonal)
                                                    {
                                                        <a asp-page="Edit" asp-route-id="@p.IdPersona" class="btn btn-sm btn-outline-primary">
                                                            <i class="fas fa-edit me-1"></i>Abrir esa ficha
                                                        </a>
                                                    }
                                                    else
                                                    {
                                                        <span class="small text-muted">Aún no es personal de la empresa</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                                <button type="submit" name="ConfirmarQueEsOtraPersona" value="true" class="btn btn-warning">
                                    <i class="fas fa-user-plus me-2"></i>Es otra persona: registrar de todos modos
                                </button>
                            </div>
                        </div>
                    }

                    <partial name="_PersonaFormulario" model="Model.Vista" />

                    <div class="d-flex gap-2 mb-4">
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save me-2"></i>Guardar
                        </button>
                        <a asp-page="Index" class="btn btn-outline-secondary">
                            <i class="fas fa-times me-2"></i>Cancelar
                        </a>
                    </div>
                </form>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script src="~/js/personas-form.js" asp-append-version="true"></script>
}
