@page
@model eGestion360Web.Pages.Flota.Catalogos.Personas.CreateModel
@{
    ViewData["Title"] = "Nuevo Personal";
}

<div class="container">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="/MainMenu">Menú Principal</a></li>
            <li class="breadcrumb-item"><a asp-page="/Flota/Catalogos/Index">Catálogos</a></li>
            <li class="breadcrumb-item"><a asp-page="Index">Personal</a></li>
            <li class="breadcrumb-item active">Nuevo</li>
        </ol>
    </nav>

    <div class="d-flex align-items-center mb-4">
        <div class="me-3 bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center"
             style="width:3rem;height:3rem;min-width:3rem;">
            <i class="fas fa-user-plus"></i>
        </div>
        <div>
            <h2 class="mb-0">Nuevo Registro de Personal</h2>
            <p class="text-muted mb-0">Completa los datos del conductor, cobrador u otro cargo</p>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <form method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger small"></div>

                <!-- Datos personales -->
                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-header bg-white fw-semibold py-3">
                        <i class="fas fa-user me-2 text-primary"></i>Datos personales
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Persona.Nombres" class="form-label fw-semibold"></label>
                                <input asp-for="Persona.Nombres" class="form-control" placeholder="Ej: Carlos Alberto" />
                                <span asp-validation-for="Persona.Nombres" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Persona.Apellidos" class="form-label fw-semibold"></label>
                                <input asp-for="Persona.Apellidos" class="form-control" placeholder="Ej: Martínez López" />
                                <span asp-validation-for="Persona.Apellidos" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Persona.TipoDocumento" class="form-label fw-semibold"></label>
                                <select asp-for="Persona.TipoDocumento" class="form-select">
                                    <option value="DNI">DNI</option>
                                    <option value="PASAPORTE">Pasaporte</option>
                                    <option value="RUC">RUC</option>
                                    <option value="OTRO">Otro</option>
                                </select>
                            </div>
                            <div class="col-md-8">
                                <label asp-for="Persona.Documento" class="form-label fw-semibold"></label>
                                <input asp-for="Persona.Documento" class="form-control" placeholder="Número de documento" />
                                <span asp-validation-for="Persona.Documento" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Persona.Telefono" class="form-label fw-semibold"></label>
                                <input asp-for="Persona.Telefono" class="form-control" placeholder="Ej: 9901-2345" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Persona.Email" class="form-label fw-semibold"></label>
                                <input asp-for="Persona.Email" class="form-control" placeholder="correo@ejemplo.com" />
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Datos laborales -->
                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-header bg-white fw-semibold py-3">
                        <i class="fas fa-briefcase me-2 text-primary"></i>Datos laborales
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="Persona.Cargo" class="form-label fw-semibold"></label>
                                <select asp-for="Persona.Cargo" class="form-select">
                                    <option value="CONDUCTOR">Conductor</option>
                                    <option value="COBRADOR">Cobrador</option>
                                    <option value="MECANICO">Mecánico</option>
                                    <option value="SUPERVISOR">Supervisor</option>
                                    <option value="OTRO">Otro</option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Persona.FechaIngreso" class="form-label fw-semibold"></label>
                                <input asp-for="Persona.FechaIngreso" class="form-control" type="date" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Persona.TarifaDiaria" class="form-label fw-semibold"></label>
                                <input asp-for="Persona.TarifaDiaria" class="form-control" placeholder="0.00" type="number" step="0.01" min="0" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Persona.MonedaTarifa" class="form-label fw-semibold"></label>
                                <select asp-for="Persona.MonedaTarifa" class="form-select">
                                    <option value="HNL">HNL — Lempira</option>
                                    <option value="USD">USD — Dólar</option>
                                </select>
                            </div>
                            <div class="col-md-4 d-flex align-items-end">
                                <div class="form-check form-switch mb-2">
                                    <input asp-for="Persona.Activo" class="form-check-input" />
                                    <label asp-for="Persona.Activo" class="form-check-label fw-semibold">Activo</label>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-2"></i>Guardar
                    </button>
                    <a asp-page="Index" class="btn btn-outline-secondary">
                        <i class="fas fa-times me-2"></i>Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
