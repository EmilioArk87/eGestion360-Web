@page
@model eGestion360Web.Pages.Flota.Catalogos.Cargos.IndexModel
@{
    ViewData["Title"] = "Cargos";
    string color = "#20c997";
}

<div class="container">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="/MainMenu">Menú Principal</a></li>
            <li class="breadcrumb-item"><a asp-page="/Flota/Index">Flota & KPIs</a></li>
            <li class="breadcrumb-item"><a asp-page="/Flota/MantenimientoDatos/Index">Mantenimiento de Datos</a></li>
            <li class="breadcrumb-item active">Cargos</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <h2 class="mb-1">
                <i class="fas fa-user-tag me-2" style="color:@color;"></i>Cargos
            </h2>
            <p class="text-muted mb-0">Conductor, cobrador, mecánico, supervisor, etc.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-page="Create" class="btn text-white" style="background-color:@color;">
                <i class="fas fa-plus me-2"></i>Nuevo Cargo
            </a>
            <a asp-page="/Flota/MantenimientoDatos/Index" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-2"></i>Volver
            </a>
        </div>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["Mensaje"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <form method="get" class="card border-0 shadow-sm mb-3">
        <div class="card-body">
            <div class="input-group">
                <span class="input-group-text"><i class="fas fa-search"></i></span>
                <input asp-for="Search" class="form-control" placeholder="Buscar por código, nombre o descripción..." />
                <button type="submit" class="btn btn-outline-primary">Buscar</button>
                @if (!string.IsNullOrWhiteSpace(Model.Search))
                {
                    <a asp-page="Index" class="btn btn-outline-secondary">Limpiar</a>
                }
            </div>
        </div>
    </form>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle paginated-table" data-page-size="15">
                    <thead class="table-light">
                        <tr>
                            <th>Código</th>
                            <th>Nombre</th>
                            <th>Descripción</th>
                            <th class="text-center">Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Items.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center text-muted py-5">
                                    <i class="fas fa-user-tag fa-2x mb-2 d-block text-secondary"></i>
                                    No hay cargos registrados.
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var c in Model.Items)
                            {
                                <tr>
                                    <td><span class="badge bg-light text-dark border">@c.Codigo</span></td>
                                    <td><strong>@c.Nombre</strong></td>
                                    <td class="text-muted small">@(c.Descripcion ?? "—")</td>
                                    <td class="text-center">
                                        @if (c.Activo)
                                        {
                                            <span class="badge bg-success">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Inactivo</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <a asp-page="Edit" asp-route-id="@c.IdCargo"
                                           class="btn btn-sm btn-outline-primary" title="Editar">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>
