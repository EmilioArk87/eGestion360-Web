@page
@using eGestion360Web.Models.Plataforma
@using eGestion360Web.Services.Plataforma
@model eGestion360Web.Pages.Admin.Suscriptores.IndexModel
@{
    ViewData["Title"] = "Suscriptores";
    var zona = eGestion360Web.Services.ZonaHorariaHonduras.Obtener();
}

<div class="container">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="/MainMenu">Menú Principal</a></li>
            <li class="breadcrumb-item active" aria-current="page">Suscriptores</li>
        </ol>
    </nav>

    <div class="d-flex align-items-start justify-content-between mb-4 flex-wrap gap-2">
        <div class="d-flex align-items-center">
            <div class="me-3 bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center"
                 style="width:3rem;height:3rem;min-width:3rem;">
                <i class="fas fa-id-card"></i>
            </div>
            <div>
                <h2 class="mb-0">Suscriptores</h2>
                <p class="text-muted mb-0">Estado y plan de cada cliente de la plataforma, y cuánto usa de sus topes</p>
            </div>
        </div>
        <a asp-page="/MainMenu" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-2"></i>Volver
        </a>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Código</th>
                            <th>Nombre</th>
                            <th class="text-center">Estado</th>
                            <th>Plan</th>
                            <th class="text-center">Empresas</th>
                            <th class="text-center">Usuarios activos</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model.Suscriptores)
                        {
                            <tr>
                                <td><code>@s.Codigo</code></td>
                                <td>
                                    @s.Nombre
                                    @if (s.Tipo != TipoTenant.Cliente)
                                    {
                                        <div class="small text-muted">@s.Tipo</div>
                                    }
                                </td>
                                <td class="text-center">
                                    <span class="badge @(s.Estado == EstadoTenant.Activo ? "bg-success" : s.Estado == EstadoTenant.Cancelado ? "bg-danger" : "bg-warning text-dark")">@s.Estado</span>
                                    @if (s.Estado == EstadoTenant.Suspendido)
                                    {
                                        <div class="small text-muted">@ReglasDeSuscriptor.NombreDelModo(s.ModoSuspension)</div>
                                    }
                                    <div class="small text-muted">desde @TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(s.FechaEstado, DateTimeKind.Utc), zona).ToString("dd/MM/yyyy")</div>
                                </td>
                                <td>
                                    @if (s.Plan == null)
                                    {
                                        <span class="badge bg-danger" title="Sin plan vigente no concede ningún derecho">sin plan</span>
                                    }
                                    else
                                    {
                                        <code>@s.Plan</code>
                                    }
                                </td>
                                <td class="text-center">@s.Empresas<span class="text-muted"> / @(s.TopeDeEmpresas?.ToString() ?? "sin tope")</span></td>
                                <td class="text-center">@s.Usuarios<span class="text-muted"> / @(s.TopeDeUsuarios?.ToString() ?? "sin tope")</span></td>
                                <td class="text-end">
                                    <a asp-page="/Admin/Suscriptores/Detalle" asp-route-id="@s.IdTenant" class="btn btn-sm btn-outline-primary">
                                        <i class="fas fa-sliders me-1"></i>Administrar
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <p class="text-muted small mt-3">Los cambios de estado y de plan quedan en la auditoría del suscriptor y en la de la plataforma.</p>
</div>
