@page "{empresaId:int}"
@model eGestion360Web.Pages.Admin.EmpresaRoles.IndexModel
@{
    ViewData["Title"] = $"Roles — {Model.Empresa?.RazonSocial}";
}

<div class="container">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="/MainMenu">Menú Principal</a></li>
            <li class="breadcrumb-item"><a asp-page="/Empresas/Index">Empresas</a></li>
            <li class="breadcrumb-item active">Roles</li>
        </ol>
    </nav>

    <div class="d-flex align-items-center justify-content-between mb-4">
        <div class="d-flex align-items-center">
            <div class="me-3 bg-warning text-white rounded-circle d-inline-flex align-items-center justify-content-center"
                 style="width:3rem;height:3rem;min-width:3rem;">
                <i class="fas fa-user-tag"></i>
            </div>
            <div>
                <h2 class="mb-0">Roles</h2>
                <p class="text-muted mb-0">@Model.Empresa?.RazonSocial</p>
            </div>
        </div>
        <button class="btn btn-success btn-sm" data-bs-toggle="modal" data-bs-target="#modalNuevoRol">
            <i class="fas fa-plus me-1"></i>Nuevo Rol
        </button>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Rol</th>
                        <th>Descripción</th>
                        <th class="text-center">Admin empresa</th>
                        <th class="text-center">Estado</th>
                        <th class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var rol in Model.Roles)
                    {
                        <tr>
                            <td><strong>@rol.Nombre</strong></td>
                            <td class="text-muted small">@rol.Descripcion</td>
                            <td class="text-center">
                                @if (rol.EsAdmin)
                                {
                                    <span class="badge bg-primary">Sí</span>
                                }
                                else
                                {
                                    <span class="text-muted small">No</span>
                                }
                            </td>
                            <td class="text-center">
                                <span class="badge @(rol.Activo ? "bg-success" : "bg-secondary")">
                                    @(rol.Activo ? "Activo" : "Inactivo")
                                </span>
                            </td>
                            <td class="text-end">
                                <a asp-page="/Admin/EmpresaRoles/Permisos"
                                   asp-route-rolId="@rol.IdRol"
                                   class="btn btn-sm btn-outline-primary me-1">
                                    <i class="fas fa-shield-alt me-1"></i>Permisos
                                </a>
                                <form method="post" class="d-inline">
                                    <input type="hidden" name="rolId" value="@rol.IdRol" />
                                    <input type="hidden" name="activo" value="@(!rol.Activo)" />
                                    <input type="hidden" name="empresaId" value="@Model.EmpresaId" />
                                    <button type="submit" asp-page-handler="Toggle"
                                            class="btn btn-sm @(rol.Activo ? "btn-outline-secondary" : "btn-outline-success")">
                                        @(rol.Activo ? "Desactivar" : "Activar")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (!Model.Roles.Any())
                    {
                        <tr>
                            <td colspan="5" class="text-center py-4 text-muted">
                                No hay roles definidos. Crea el primero.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <a asp-page="/Empresas/Index" class="btn btn-outline-secondary">
        <i class="fas fa-arrow-left me-2"></i>Volver
    </a>
</div>

<!-- Modal nuevo rol -->
<div class="modal fade" id="modalNuevoRol" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <form method="post" asp-page-handler="Crear">
                <input type="hidden" name="empresaId" value="@Model.EmpresaId" />
                <div class="modal-header bg-success text-white">
                    <h5 class="modal-title"><i class="fas fa-user-tag me-2"></i>Nuevo Rol</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Nombre del rol</label>
                        <input type="text" name="nombre" class="form-control" required maxlength="50"
                               placeholder="Ej: Conductor, Supervisor..." />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Descripción</label>
                        <input type="text" name="descripcion" class="form-control" maxlength="200" />
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" name="esAdmin" id="chkEsAdmin" />
                        <label class="form-check-label" for="chkEsAdmin">Admin de empresa (acceso total)</label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-success">
                        <i class="fas fa-save me-1"></i>Crear Rol
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
