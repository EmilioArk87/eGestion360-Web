@page "{rolId:int}"
@model eGestion360Web.Pages.Admin.EmpresaRoles.PermisosModel
@{
    ViewData["Title"] = $"Permisos — {Model.Rol?.Nombre}";
}

<div class="container">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="/MainMenu">Menú Principal</a></li>
            <li class="breadcrumb-item"><a asp-page="/Admin/RolesPermisos/Index" asp-route-empresaId="@Model.Rol?.IdEmpresa">Roles y Permisos</a></li>
            <li class="breadcrumb-item active">Permisos del Rol</li>
        </ol>
    </nav>

    <!-- Cabecera -->
    <div class="d-flex align-items-start justify-content-between mb-4">
        <div class="d-flex align-items-center">
            <div class="me-3 bg-warning text-white rounded-circle d-inline-flex align-items-center justify-content-center"
                 style="width:3rem;height:3rem;min-width:3rem;">
                <i class="fas fa-shield-alt"></i>
            </div>
            <div>
                <h2 class="mb-0">Permisos del Rol</h2>
                <p class="text-muted mb-0">
                    <strong>@Model.Rol?.Nombre</strong>
                    <span class="mx-1 text-muted">—</span>
                    <i class="fas fa-building me-1 text-muted"></i>@Model.Empresa?.RazonSocial
                </p>
            </div>
        </div>
        <a asp-page="/Admin/RolesPermisos/Index" asp-route-empresaId="@Model.Rol?.IdEmpresa"
           class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-2"></i>Volver
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model.Rol?.EsAdmin == true)
    {
        <!-- Rol admin: sin permisos individuales -->
        <div class="alert alert-primary d-flex align-items-center gap-3">
            <i class="fas fa-crown fa-2x"></i>
            <div>
                <strong>Rol de Administrador de Empresa</strong><br>
                <span>Este rol tiene acceso completo a todos los módulos contratados. No requiere configurar permisos individuales.</span>
            </div>
        </div>
    }
    else if (!Model.Items.Any())
    {
        <!-- Sin módulos contratados -->
        <div class="alert alert-warning d-flex align-items-start gap-3">
            <i class="fas fa-exclamation-triangle fa-2x mt-1"></i>
            <div>
                <strong>La empresa no tiene módulos contratados</strong><br>
                Para configurar permisos en este rol primero debes asignar módulos a la empresa
                <strong>@Model.Empresa?.RazonSocial</strong>.
                <div class="mt-2">
                    <a asp-page="/Admin/EmpresaModulos/Index"
                       asp-route-empresaId="@Model.Rol?.IdEmpresa"
                       class="btn btn-warning btn-sm">
                        <i class="fas fa-puzzle-piece me-1"></i>Asignar módulos a la empresa
                    </a>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Matriz de permisos -->
        <div class="alert alert-info small py-2 mb-3">
            <i class="fas fa-info-circle me-1"></i>
            Marca los permisos que deseas otorgar a este rol por cada módulo y presiona <strong>Guardar</strong>.
        </div>

        <form method="post">
            <input type="hidden" name="rolId" value="@Model.RolId" />

            <div class="card border-0 shadow-sm mb-4">
                <div class="card-header bg-white border-bottom d-flex align-items-center justify-content-between py-3">
                    <span class="fw-semibold">
                        <i class="fas fa-puzzle-piece me-2 text-primary"></i>
                        Módulos contratados (@Model.Items.Count)
                    </span>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-outline-success btn-sm" onclick="toggleTodos(true)">
                            <i class="fas fa-check-double me-1"></i>Activar todo
                        </button>
                        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="toggleTodos(false)">
                            <i class="fas fa-times me-1"></i>Limpiar todo
                        </button>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table align-middle mb-0" id="tablaPermisos">
                            <thead class="table-light">
                                <tr>
                                    <th style="min-width:200px">Módulo</th>
                                    <th class="text-center" style="width:100px">
                                        <i class="fas fa-eye text-info me-1"></i>Ver
                                    </th>
                                    <th class="text-center" style="width:100px">
                                        <i class="fas fa-plus-circle text-success me-1"></i>Crear
                                    </th>
                                    <th class="text-center" style="width:100px">
                                        <i class="fas fa-edit text-warning me-1"></i>Editar
                                    </th>
                                    <th class="text-center" style="width:100px">
                                        <i class="fas fa-trash text-danger me-1"></i>Eliminar
                                    </th>
                                    <th class="text-center" style="width:100px">Todo</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <div class="bg-primary text-white rounded d-inline-flex align-items-center justify-content-center"
                                                     style="width:2rem;height:2rem;min-width:2rem;">
                                                    <i class="fas @(item.Modulo.Icono ?? "fa-cube") small"></i>
                                                </div>
                                                <div>
                                                    <strong>@item.Modulo.Nombre</strong>
                                                    @if (!string.IsNullOrEmpty(item.Modulo.Descripcion))
                                                    {
                                                        <br /><small class="text-muted">@item.Modulo.Descripcion</small>
                                                    }
                                                </div>
                                            </div>
                                            <input type="hidden" name="modulos" value="@item.Modulo.IdModulo" />
                                        </td>
                                        <td class="text-center">
                                            <input type="checkbox" class="form-check-input chk-modulo"
                                                   data-modulo="@item.Modulo.IdModulo"
                                                   name="ver_@item.Modulo.IdModulo" value="true"
                                                   @(item.PuedeVer ? "checked" : "") />
                                        </td>
                                        <td class="text-center">
                                            <input type="checkbox" class="form-check-input chk-modulo"
                                                   data-modulo="@item.Modulo.IdModulo"
                                                   name="crear_@item.Modulo.IdModulo" value="true"
                                                   @(item.PuedeCrear ? "checked" : "") />
                                        </td>
                                        <td class="text-center">
                                            <input type="checkbox" class="form-check-input chk-modulo"
                                                   data-modulo="@item.Modulo.IdModulo"
                                                   name="editar_@item.Modulo.IdModulo" value="true"
                                                   @(item.PuedeEditar ? "checked" : "") />
                                        </td>
                                        <td class="text-center">
                                            <input type="checkbox" class="form-check-input chk-modulo"
                                                   data-modulo="@item.Modulo.IdModulo"
                                                   name="eliminar_@item.Modulo.IdModulo" value="true"
                                                   @(item.PuedeEliminar ? "checked" : "") />
                                        </td>
                                        <td class="text-center">
                                            <input type="checkbox" class="form-check-input chk-todo"
                                                   data-modulo="@item.Modulo.IdModulo"
                                                   title="Activar/desactivar todos los permisos de este módulo"
                                                   @(item.PuedeVer && item.PuedeCrear && item.PuedeEditar && item.PuedeEliminar ? "checked" : "") />
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save me-2"></i>Guardar permisos
                </button>
            </div>
        </form>
    }
</div>

@section Scripts {
    <script>
        // Checkbox "Todo" por fila — activa/desactiva los 4 permisos de esa fila
        document.querySelectorAll('.chk-todo').forEach(chkTodo => {
            chkTodo.addEventListener('change', function () {
                const modulo = this.dataset.modulo;
                document.querySelectorAll(`.chk-modulo[data-modulo="${modulo}"]`)
                    .forEach(chk => chk.checked = this.checked);
            });
        });

        // Si cambia algún permiso individual, actualiza el "Todo" de esa fila
        document.querySelectorAll('.chk-modulo').forEach(chk => {
            chk.addEventListener('change', function () {
                const modulo = this.dataset.modulo;
                const todos = document.querySelectorAll(`.chk-modulo[data-modulo="${modulo}"]`);
                const chkTodo = document.querySelector(`.chk-todo[data-modulo="${modulo}"]`);
                if (chkTodo) chkTodo.checked = [...todos].every(c => c.checked);
            });
        });

        // Activar / limpiar todos los permisos de la tabla
        function toggleTodos(estado) {
            document.querySelectorAll('.chk-modulo, .chk-todo').forEach(chk => chk.checked = estado);
        }
    </script>
}
