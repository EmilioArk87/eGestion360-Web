@page "{rolId:int}"
@model eGestion360Web.Pages.Admin.EmpresaRoles.PermisosModel
@{
    ViewData["Title"] = $"Permisos — {Model.Datos?.NombreRol}";
}

<div class="container">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="/MainMenu">Menú Principal</a></li>
            <li class="breadcrumb-item"><a asp-page="/Admin/RolesPermisos/Index" asp-route-empresaId="@Model.Datos?.IdEmpresa">Roles y Permisos</a></li>
            <li class="breadcrumb-item active">Permisos del Rol</li>
        </ol>
    </nav>

    <!-- Cabecera -->
    <div class="d-flex align-items-start justify-content-between mb-4">
        <div class="d-flex align-items-center">
            <div class="me-3 bg-warning text-white rounded-circle d-inline-flex align-items-center justify-content-center"
                 style="width:3rem;height:3rem;min-width:3rem;">
                <i class="fas fa-shield-alt"></i>
            </div>
            <div>
                <h2 class="mb-0">Permisos del Rol</h2>
                <p class="text-muted mb-0">
                    <strong>@Model.Datos?.NombreRol</strong>
                    <span class="mx-1 text-muted">—</span>
                    <i class="fas fa-building me-1 text-muted"></i>@Model.Empresa?.RazonSocial
                </p>
            </div>
        </div>
        <a asp-page="/Admin/RolesPermisos/Index" asp-route-empresaId="@Model.Datos?.IdEmpresa"
           class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-2"></i>Volver
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model.Datos?.MarcaEsAdmin == true)
    {
        <div class="alert alert-secondary d-flex align-items-start gap-3 small">
            <i class="fas fa-info-circle mt-1"></i>
            <div>
                La marca «Admin de empresa» de este rol <strong>ya no concede permisos</strong>: lo que vale es lo que se marque aquí.
                El administrador de una empresa se define en su cuenta, no en el rol.
            </div>
        </div>
    }

    @if (Model.Datos == null || !Model.Datos.Grupos.Any())
    {
        <div class="alert alert-warning d-flex align-items-start gap-3">
            <i class="fas fa-exclamation-triangle fa-2x mt-1"></i>
            <div>
                <strong>No hay permisos que configurar</strong><br>
                La empresa <strong>@Model.Empresa?.RazonSocial</strong> no tiene módulos activos. Para configurar permisos en este rol primero hay que asignarle módulos.
                <div class="mt-2">
                    <a asp-page="/Admin/EmpresaModulos/Index"
                       asp-route-empresaId="@Model.Datos?.IdEmpresa"
                       class="btn btn-warning btn-sm">
                        <i class="fas fa-puzzle-piece me-1"></i>Asignar módulos a la empresa
                    </a>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info small py-2 mb-3">
            <i class="fas fa-info-circle me-1"></i>
            Marca lo que este rol puede hacer en cada módulo y presiona <strong>Guardar</strong>. Pasa el cursor sobre una casilla para ver qué permite.
            Quien tenga el rol verá los cambios en su siguiente petición (a lo más en 30 segundos).
        </div>

        <form method="post" id="formPermisos">
            <input type="hidden" name="rolId" value="@Model.RolId" />

            <div class="d-flex justify-content-end gap-2 mb-3">
                <button type="button" class="btn btn-outline-success btn-sm" onclick="marcarTodo(null, true)">
                    <i class="fas fa-check-double me-1"></i>Marcar todo
                </button>
                <button type="button" class="btn btn-outline-secondary btn-sm" onclick="marcarTodo(null, false)">
                    <i class="fas fa-times me-1"></i>Limpiar todo
                </button>
            </div>

            @foreach (var grupo in Model.Datos.Grupos)
            {
                var acciones = grupo.Acciones;
                <div class="card border-0 shadow-sm mb-4">
                    <div class="card-header bg-white border-bottom d-flex align-items-center justify-content-between py-3">
                        <span class="d-flex align-items-center gap-2">
                            <span class="bg-primary text-white rounded d-inline-flex align-items-center justify-content-center"
                                  style="width:2rem;height:2rem;min-width:2rem;">
                                <i class="fas @(grupo.Icono ?? "fa-cube") small"></i>
                            </span>
                            <span>
                                <strong>@grupo.Nombre</strong>
                                @if (!string.IsNullOrEmpty(grupo.Descripcion))
                                {
                                    <br /><small class="text-muted">@grupo.Descripcion</small>
                                }
                            </span>
                        </span>
                        <span class="d-flex gap-2">
                            <button type="button" class="btn btn-outline-success btn-sm" onclick="marcarTodo('@grupo.Codigo', true)">Marcar</button>
                            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="marcarTodo('@grupo.Codigo', false)">Limpiar</button>
                        </span>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th style="min-width:200px">Pantalla</th>
                                        @foreach (var accion in acciones)
                                        {
                                            <th class="text-center" style="min-width:90px">@(char.ToUpperInvariant(accion[0]) + accion[1..].Replace('_', ' '))</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var recurso in grupo.Recursos)
                                    {
                                        <tr>
                                            <td>@recurso.Nombre</td>
                                            @foreach (var accion in acciones)
                                            {
                                                var permiso = recurso.Permisos.FirstOrDefault(p => p.Accion == accion);
                                                <td class="text-center">
                                                    @if (permiso != null)
                                                    {
                                                        <input type="checkbox" class="form-check-input chk-permiso" data-grupo="@grupo.Codigo"
                                                               name="codigos" value="@permiso.Codigo" title="@permiso.Descripcion"
                                                               aria-label="@recurso.Nombre: @permiso.Etiqueta"
                                                               @(permiso.Concedido ? "checked" : "") />
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted" aria-hidden="true">—</span>
                                                    }
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }

            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="fas fa-save me-2"></i>Guardar permisos
                </button>
            </div>
        </form>
    }
</div>

@section Scripts {
    <script>
        // «Marcar» / «Limpiar» de un módulo (o de todos si el código es nulo).
        function marcarTodo(grupo, valor) {
            document.querySelectorAll('.chk-permiso').forEach(function (chk) {
                if (grupo === null || chk.dataset.grupo === grupo) chk.checked = valor;
            });
        }
    </script>
}
