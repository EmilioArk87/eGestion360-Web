@page
@using eGestion360Web.Services.Auditoria
@model eGestion360Web.Pages.Admin.Auditoria.IndexModel
@{
    ViewData["Title"] = "Auditoría";
    var desde = Model.Desde?.ToString("yyyy-MM-dd");
    var hasta = Model.Hasta?.ToString("yyyy-MM-dd");
}

<div class="container-fluid">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="/MainMenu">Menú Principal</a></li>
            <li class="breadcrumb-item active" aria-current="page">Auditoría</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <h2 class="mb-1"><i class="fas fa-clipboard-list me-2"></i>Auditoría de la empresa</h2>
            <p class="text-muted mb-0">Cambios de usuarios, roles, permisos, módulos y accesos; invitaciones, accesos denegados, entradas a un sitio y el soporte recibido. Solo lectura.</p>
        </div>
        <a asp-page="/MainMenu" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-2"></i>Volver
        </a>
    </div>

    @if (Model.SinTenant)
    {
        <div class="alert alert-info">
            <i class="fas fa-info-circle me-2"></i>Esta auditoría es la de un tenant. Elija primero el tenant en
            <a asp-page="/Admin/Soporte/Index">Soporte por tenant</a>, o consulte la <a asp-page="/Admin/AuditoriaPlataforma/Index">auditoría de la plataforma</a>.
        </div>
    }
    else
    {
        <form method="get" class="card border-0 shadow-sm mb-3">
            <div class="card-body">
                <div class="row g-2 align-items-end">
                    <div class="col-md-2">
                        <label asp-for="Desde" class="form-label small mb-1">Desde</label>
                        <input asp-for="Desde" type="date" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-2">
                        <label asp-for="Hasta" class="form-label small mb-1">Hasta</label>
                        <input asp-for="Hasta" type="date" class="form-control form-control-sm" />
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Tipo" class="form-label small mb-1">Evento</label>
                        <select asp-for="Tipo" class="form-select form-select-sm">
                            <option value="">— Todos —</option>
                            @foreach (var t in Model.Tipos)
                            {
                                <option value="@t">@ConsultaDeAuditoria.NombreDeTipo(t)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label asp-for="Resultado" class="form-label small mb-1">Resultado</label>
                        <select asp-for="Resultado" class="form-select form-select-sm">
                            <option value="">— Todos —</option>
                            @foreach (var r in ConsultaDeAuditoria.Resultados)
                            {
                                <option value="@r">@ConsultaDeAuditoria.NombreDeResultado(r)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Usuario" class="form-label small mb-1">Usuario</label>
                        <input asp-for="Usuario" class="form-control form-control-sm" placeholder="Parte del nombre" />
                    </div>
                    <div class="col-12 d-flex gap-2 flex-wrap">
                        <button type="submit" class="btn btn-sm btn-outline-primary"><i class="fas fa-filter me-1"></i>Filtrar</button>
                        <a asp-page="Index" class="btn btn-sm btn-outline-secondary">Últimos @ConsultaDeAuditoria.DiasPorOmision días</a>
                        <a asp-page="Index" asp-page-handler="Excel" asp-route-desde="@desde" asp-route-hasta="@hasta" asp-route-tipo="@Model.Tipo"
                           asp-route-resultado="@Model.Resultado" asp-route-usuario="@Model.Usuario" class="btn btn-sm btn-outline-success ms-md-auto">
                            <i class="fas fa-file-excel me-1"></i>Exportar a Excel
                        </a>
                        <a asp-page="Imprimir" asp-route-desde="@desde" asp-route-hasta="@hasta" asp-route-tipo="@Model.Tipo"
                           asp-route-resultado="@Model.Resultado" asp-route-usuario="@Model.Usuario" target="_blank" class="btn btn-sm btn-outline-danger">
                            <i class="fas fa-file-pdf me-1"></i>Imprimir o guardar como PDF
                        </a>
                    </div>
                </div>
                <div class="form-text">Las fechas y horas son de Honduras. Cada exportación queda registrada en esta misma auditoría; se exportan como mucho @ConsultaDeAuditoria.MaximoParaExportar.ToString("N0") eventos, los más recientes.</div>
            </div>
        </form>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <partial name="_TablaDeAuditoria" model="new TablaDeAuditoria(Model.Resultados.Filas, ConTenant: false, ParaImprimir: false)" />
                </div>
            </div>
            <div class="card-footer d-flex justify-content-between align-items-center">
                <small class="text-muted">@Model.Resultados.Total.ToString("N0") eventos@(Model.Resultados.TotalDePaginas > 1 ? $" · página {Model.Resultados.Pagina} de {Model.Resultados.TotalDePaginas}" : "")</small>
                @if (Model.Resultados.TotalDePaginas > 1)
                {
                    <nav>
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(Model.Pagina <= 1 ? "disabled" : "")">
                                <a class="page-link" asp-page="Index" asp-route-desde="@desde" asp-route-hasta="@hasta" asp-route-tipo="@Model.Tipo"
                                   asp-route-resultado="@Model.Resultado" asp-route-usuario="@Model.Usuario" asp-route-pagina="@(Model.Pagina - 1)">Anterior</a>
                            </li>
                            <li class="page-item @(Model.Pagina >= Model.Resultados.TotalDePaginas ? "disabled" : "")">
                                <a class="page-link" asp-page="Index" asp-route-desde="@desde" asp-route-hasta="@hasta" asp-route-tipo="@Model.Tipo"
                                   asp-route-resultado="@Model.Resultado" asp-route-usuario="@Model.Usuario" asp-route-pagina="@(Model.Pagina + 1)">Siguiente</a>
                            </li>
                        </ul>
                    </nav>
                }
            </div>
        </div>
    }
</div>
