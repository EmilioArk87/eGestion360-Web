@page
@model eGestion360Web.Pages.Admin.Modulos.IndexModel
@{
    ViewData["Title"] = "Módulos del Sistema";
}

<div class="container">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="/MainMenu">Menú Principal</a></li>
            <li class="breadcrumb-item active">Módulos del Sistema</li>
        </ol>
    </nav>

    <div class="d-flex align-items-start justify-content-between mb-4">
        <div class="d-flex align-items-center">
            <div class="me-3 bg-dark text-white rounded-circle d-inline-flex align-items-center justify-content-center"
                 style="width:3rem;height:3rem;min-width:3rem;">
                <i class="fas fa-puzzle-piece"></i>
            </div>
            <div>
                <h2 class="mb-0">Módulos del Sistema</h2>
                <p class="text-muted mb-0">Catálogo de módulos disponibles para las empresas</p>
            </div>
        </div>
        <a asp-page="/MainMenu" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-2"></i>Volver
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 paginated-table" data-page-size="15">
                    <thead class="table-light">
                        <tr>
                            <th>Módulo</th>
                            <th>Código</th>
                            <th>Descripción</th>
                            <th class="text-center">Orden</th>
                            <th class="text-center">Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in Model.Modulos)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="fas @(m.Icono ?? "fa-cube") text-primary"></i>
                                        <strong>@m.Nombre</strong>
                                    </div>
                                </td>
                                <td><code>@m.Codigo</code></td>
                                <td class="text-muted small">@m.Descripcion</td>
                                <td class="text-center">@m.Orden</td>
                                <td class="text-center">
                                    @if (m.Activo)
                                    {
                                        <span class="badge bg-success">Activo</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Inactivo</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <form method="post" class="d-inline">
                                        <input type="hidden" name="id" value="@m.IdModulo" />
                                        <input type="hidden" name="activo" value="@(!m.Activo)" />
                                        <button type="submit" class="btn btn-sm @(m.Activo ? "btn-outline-secondary" : "btn-outline-success")">
                                            @(m.Activo ? "Desactivar" : "Activar")
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>
