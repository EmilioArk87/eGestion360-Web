@page "{id:int}"
@model eGestion360Web.Pages.Admin.Personas.HistorialModel
@{
    ViewData["Title"] = "Historial de cambios";
    var historial = Model.Historial;
}

<div class="container">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="/MainMenu">Menú Principal</a></li>
            <li class="breadcrumb-item"><a asp-page="Index">Personas del sistema</a></li>
            <li class="breadcrumb-item active">Historial</li>
        </ol>
    </nav>

    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <h2 class="mb-1"><i class="fas fa-history me-2" style="color:#0d6efd;"></i>Historial de cambios</h2>
            @if (historial != null)
            {
                <p class="text-muted mb-0">@historial.NombrePersona</p>
            }
        </div>
        <div class="d-flex gap-2">
            @if (historial != null)
            {
                <a asp-page="Edit" asp-route-id="@Model.IdPersona" class="btn btn-outline-primary">
                    <i class="fas fa-edit me-2"></i>Ver y editar
                </a>
            }
            <a asp-page="Index" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-2"></i>Volver</a>
        </div>
    </div>

    @if (historial != null)
    {
        <div class="alert alert-light border small">
            <i class="fas fa-info-circle me-1"></i>
            Las horas son de Honduras. Como administrador general ves todos los cambios, de todas las empresas, con la empresa desde la
            que se hizo cada uno. Los números de documento se guardan ocultos.
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm table-hover mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Fecha y hora</th>
                                <th>Qué</th>
                                <th>Campo</th>
                                <th>Antes</th>
                                <th>Después</th>
                                <th>Quién</th>
                                <th>Empresa</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!historial.Filas.Any())
                            {
                                <tr>
                                    <td colspan="7" class="text-center text-muted py-5">
                                        <i class="fas fa-clock fa-2x mb-2 d-block text-secondary"></i>
                                        Todavía no hay cambios registrados para esta persona.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                Guid? anterior = null;
                                foreach (var f in historial.Filas)
                                {
                                    var inicioGrupo = anterior != f.IdTransaccion;
                                    anterior = f.IdTransaccion;
                                    var colorOperacion = f.Operacion switch { "Alta" => "bg-success", "Baja" => "bg-danger", _ => "bg-primary" };
                                    <tr class="@(inicioGrupo ? "border-top border-2" : "")">
                                        <td class="text-nowrap small @(inicioGrupo ? "" : "text-muted")">
                                            @(inicioGrupo ? f.FechaHora.ToString("dd/MM/yyyy HH:mm") : "")
                                        </td>
                                        <td class="text-nowrap">
                                            <span class="badge @colorOperacion">@f.Operacion</span>
                                            <span class="small text-muted">@f.Entidad</span>
                                        </td>
                                        @if (f.Campo != null)
                                        {
                                            <td>@f.Campo</td>
                                            <td class="text-muted">@(string.IsNullOrEmpty(f.ValorAnterior) ? "—" : f.ValorAnterior)</td>
                                            <td>@(string.IsNullOrEmpty(f.ValorNuevo) ? "—" : f.ValorNuevo)</td>
                                        }
                                        else
                                        {
                                            <td colspan="3" class="small">
                                                @if (f.Detalle != null)
                                                {
                                                    @f.Detalle
                                                }
                                                else
                                                {
                                                    <span class="text-muted fst-italic">Sin detalle disponible</span>
                                                }
                                            </td>
                                        }
                                        <td class="small">@f.Usuario</td>
                                        <td class="small text-nowrap @(f.Empresa == null ? "text-muted" : "")">@(f.Empresa ?? "—")</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            @if (historial.Filas.Any())
            {
                <div class="card-footer bg-white text-muted small py-2 px-3">
                    @historial.Filas.Count cambio(s) mostrado(s)@(historial.Truncado ? ". Hay más cambios antiguos que no se muestran." : "")
                </div>
            }
        </div>
    }
</div>
