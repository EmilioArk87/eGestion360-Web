@page "{id:int}"
@model eGestion360Web.Pages.Admin.Personas.EditModel
@using eGestion360Web.Models.Personas
@using eGestion360Web.Services.Personas
@{
    ViewData["Title"] = "Editar persona";
    var edicion = Model.Edicion;
    var detalle = Model.Detalle;
}

<div class="container">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="/MainMenu">Menú Principal</a></li>
            <li class="breadcrumb-item"><a asp-page="Index">Personas del sistema</a></li>
            <li class="breadcrumb-item active">Editar</li>
        </ol>
    </nav>

    <div class="d-flex align-items-start justify-content-between mb-4">
        <div class="d-flex align-items-center">
            <div class="me-3 bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center"
                 style="width:3rem;height:3rem;min-width:3rem;">
                <i class="fas fa-user-edit"></i>
            </div>
            <div>
                <h2 class="mb-0">Editar persona</h2>
                @if (edicion != null)
                {
                    <p class="text-muted mb-0">
                        @if (edicion.EstadoIdentidad == EstadosIdentidad.Verificada)
                        {
                            <span class="badge bg-success me-1"><i class="fas fa-check-circle me-1"></i>Identidad verificada</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary me-1" title="Todavía no tiene un documento de identidad registrado"><i class="fas fa-hourglass-half me-1"></i>Identidad pendiente</span>
                        }
                        <span class="small">
                            Registrada por @edicion.CreadoPor el @edicion.FechaCreacion.AddHours(-6).ToString("dd/MM/yyyy")
                            @if (edicion.FechaModificacion.HasValue)
                            {
                                <text>· Última modificación por @(edicion.ModificadoPor ?? "—") el @edicion.FechaModificacion.Value.AddHours(-6).ToString("dd/MM/yyyy HH:mm")</text>
                            }
                        </span>
                    </p>
                }
            </div>
        </div>
        <div class="d-flex gap-2">
            <a asp-page="Historial" asp-route-id="@Model.IdPersona" class="btn btn-outline-secondary">
                <i class="fas fa-history me-2"></i>Historial
            </a>
            <a asp-page="Index" class="btn btn-outline-secondary"><i class="fas fa-arrow-left me-2"></i>Volver</a>
        </div>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-10">

            @if (detalle != null)
            {
                <!-- Empresas y roles (solo lectura) -->
                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-header bg-white fw-semibold py-3">
                        <i class="fas fa-building me-2 text-primary"></i>Empresas y roles
                    </div>
                    <div class="card-body p-0">
                        @if (!detalle.Vinculos.Any())
                        {
                            <p class="text-muted fst-italic m-3">Esta persona no está asignada a ninguna empresa.</p>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-sm mb-0 align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th>Empresa</th>
                                            <th>Rol</th>
                                            <th>Detalle</th>
                                            <th>Desde</th>
                                            <th>Hasta</th>
                                            <th>Estado</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var v in detalle.Vinculos)
                                        {
                                            <tr class="@(v.Vigente ? "" : "text-muted")">
                                                <td>@v.Empresa</td>
                                                <td><span class="badge @EtiquetasVinculo.Clase(v.TipoVinculo, v.Vigente) fw-normal">@EtiquetasVinculo.Rol(v.TipoVinculo)</span></td>
                                                <td class="small">@(v.Detalle ?? "—")</td>
                                                <td class="small text-nowrap">@(v.FechaInicio?.ToString("dd/MM/yyyy") ?? "—")</td>
                                                <td class="small text-nowrap">@(v.FechaFin?.ToString("dd/MM/yyyy") ?? "—")</td>
                                                <td class="small text-nowrap">@EtiquetasVinculo.Estado(v.Activo, v.FechaFin)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        <div class="px-3 py-2 border-top small" data-prueba="usuarios-de-la-persona">
                            <i class="fas fa-user-lock me-1 text-primary"></i>
                            <span class="fw-semibold">Usuarios del sistema:</span>
                            @if (detalle.UsuariosDelSistema.Any())
                            {
                                <span>@string.Join(", ", detalle.UsuariosDelSistema)</span>
                            }
                            else
                            {
                                <span class="text-muted">ninguno</span>
                            }
                        </div>
                        <div class="small text-muted px-3 py-2 border-top">
                            <i class="fas fa-info-circle me-1"></i>
                            Los vínculos y los datos de empleo (cargo, código de empleado y tarifa) los administra cada empresa desde su pantalla;
                            aquí solo se editan los datos personales, que son los mismos en todas las empresas.
                        </div>
                    </div>
                </div>
            }

            <form method="post" id="form-persona" novalidate>
                <input type="hidden" asp-for="TokenConcurrencia" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger small"></div>

                <partial name="/Pages/Flota/Catalogos/Personas/_PersonaFormulario.cshtml" model="Model.Vista" />

                <div class="d-flex gap-2 mb-4">
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save me-2"></i>Guardar cambios
                    </button>
                    <a asp-page="Index" class="btn btn-outline-secondary">
                        <i class="fas fa-times me-2"></i>Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/personas-form.js" asp-append-version="true"></script>
}
