@page "{empresaId:int}"
@model eGestion360Web.Pages.Admin.EmpresaModulos.IndexModel
@{
    ViewData["Title"] = $"Módulos — {Model.Empresa?.RazonSocial}";
}

<div class="container">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="/MainMenu">Menú Principal</a></li>
            <li class="breadcrumb-item"><a asp-page="/Empresas/Index">Empresas</a></li>
            <li class="breadcrumb-item active">Módulos</li>
        </ol>
    </nav>

    <div class="d-flex align-items-center mb-4">
        <div class="me-3 bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center"
             style="width:3rem;height:3rem;min-width:3rem;">
            <i class="fas fa-puzzle-piece"></i>
        </div>
        <div>
            <h2 class="mb-0">Módulos contratados</h2>
            <p class="text-muted mb-0">@Model.Empresa?.RazonSocial</p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <form method="post">
        <input type="hidden" name="empresaId" value="@Model.EmpresaId" />
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body">
                <div class="row g-3">
                    @foreach (var item in Model.Items)
                    {
                        <div class="col-md-6 col-lg-4">
                            <div class="card h-100 border @(item.Activo ? "border-primary" : "")">
                                <div class="card-body p-3">
                                    <div class="d-flex align-items-start gap-3">
                                        <div class="form-check mt-1">
                                            <input class="form-check-input" type="checkbox"
                                                   name="modulosSeleccionados" value="@item.Modulo.IdModulo"
                                                   id="mod_@item.Modulo.IdModulo"
                                                   @(item.Activo ? "checked" : "") />
                                        </div>
                                        <label class="form-check-label w-100" for="mod_@item.Modulo.IdModulo" style="cursor:pointer;">
                                            <div class="d-flex align-items-center gap-2 mb-1">
                                                <i class="fas @(item.Modulo.Icono ?? "fa-cube") text-primary"></i>
                                                <strong>@item.Modulo.Nombre</strong>
                                            </div>
                                            <p class="text-muted small mb-0">@item.Modulo.Descripcion</p>
                                        </label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">
                <i class="fas fa-save me-2"></i>Guardar módulos
            </button>
            <a asp-page="/Empresas/Index" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-2"></i>Volver
            </a>
        </div>
    </form>
</div>
