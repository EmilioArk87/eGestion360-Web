@page
@model eGestion360Web.Pages.Admin.RolesPermisos.IndexModel
@{
    ViewData["Title"] = "Roles y Permisos";
}

<div class="container">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-page="/MainMenu">Menú Principal</a></li>
            <li class="breadcrumb-item active">Roles y Permisos</li>
        </ol>
    </nav>

    <div class="d-flex align-items-start justify-content-between mb-4">
        <div class="d-flex align-items-center">
            <div class="me-3 bg-warning text-white rounded-circle d-inline-flex align-items-center justify-content-center"
                 style="width:3rem;height:3rem;min-width:3rem;">
                <i class="fas fa-user-tag"></i>
            </div>
            <div>
                <h2 class="mb-0">Roles y Permisos</h2>
                <p class="text-muted mb-0">Gestiona los roles y permisos por empresa</p>
            </div>
        </div>
        <a asp-page="/MainMenu" class="btn btn-outline-secondary">
            <i class="fas fa-arrow-left me-2"></i>Volver
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Selector de empresa -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-6">
                    <label class="form-label fw-semibold">
                        <i class="fas fa-building me-1 text-primary"></i>Empresa
                    </label>
                    <select name="empresaId" class="form-select" onchange="this.form.submit()">
                        <option value="">— Selecciona una empresa —</option>
                        @foreach (var e in Model.Empresas)
                        {
                            if (Model.EmpresaId == e.IdEmpresa)
                            {
                                <option value="@e.IdEmpresa" selected>@e.RazonSocial</option>
                            }
                            else
                            {
                                <option value="@e.IdEmpresa">@e.RazonSocial</option>
                            }
                        }
                    </select>
                </div>
            </form>
        </div>
    </div>

    @if (Model.EmpresaSeleccionada != null)
    {
        <!-- Cabecera empresa seleccionada -->
        <div class="d-flex align-items-center justify-content-between mb-3">
            <div>
                <h4 class="mb-0">
                    <i class="fas fa-building me-2 text-primary"></i>@Model.EmpresaSeleccionada.RazonSocial
                </h4>
                <small class="text-muted">
                    Módulos contratados:
                    @if (Model.ModulosEmpresa.Any())
                    {
                        @string.Join(", ", Model.ModulosEmpresa.Select(m => m.Nombre))
                    }
                    else
                    {
                        <span class="text-warning">Sin módulos asignados</span>
                    }
                    — <a asp-page="/Admin/EmpresaModulos/Index" asp-route-empresaId="@Model.EmpresaId"
                         class="text-decoration-none small">Gestionar módulos</a>
                </small>
            </div>
            <button class="btn btn-success btn-sm" data-bs-toggle="modal" data-bs-target="#modalNuevoRol">
                <i class="fas fa-plus me-1"></i>Nuevo Rol
            </button>
        </div>

        <!-- Tabla de roles -->
        <div class="card border-0 shadow-sm">
            <div class="card-body p-0">
                <table class="table table-hover align-middle mb-0 paginated-table" data-page-size="15">
                    <thead class="table-light">
                        <tr>
                            <th>Rol</th>
                            <th>Descripción</th>
                            <th class="text-center">Admin empresa</th>
                            <th class="text-center">Usuarios</th>
                            <th class="text-center">Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var rol in Model.Roles)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <i class="fas fa-user-tag text-warning"></i>
                                        <strong>@rol.Nombre</strong>
                                    </div>
                                </td>
                                <td class="text-muted small">@(rol.Descripcion ?? "—")</td>
                                <td class="text-center">
                                    @if (rol.EsAdmin)
                                    {
                                        <span class="badge bg-primary">Sí</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-secondary">@rol.Usuarios.Count()</span>
                                </td>
                                <td class="text-center">
                                    <span class="badge @(rol.Activo ? "bg-success" : "bg-secondary")">
                                        @(rol.Activo ? "Activo" : "Inactivo")
                                    </span>
                                </td>
                                <td class="text-end">
                                    <a asp-page="/Admin/EmpresaRoles/Permisos"
                                       asp-route-rolId="@rol.IdRol"
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="fas fa-shield-alt me-1"></i>Permisos
                                    </a>
                                    <button type="button"
                                            class="btn btn-sm btn-outline-secondary"
                                            data-bs-toggle="modal"
                                            data-bs-target="#modalEditarRol"
                                            data-rolid="@rol.IdRol"
                                            data-nombre="@rol.Nombre"
                                            data-descripcion="@rol.Descripcion"
                                            data-esadmin="@rol.EsAdmin.ToString().ToLower()">
                                        <i class="fas fa-edit me-1"></i>Editar
                                    </button>
                                    <form method="post" asp-page-handler="Toggle" class="d-inline">
                                        <input type="hidden" name="rolId" value="@rol.IdRol" />
                                        <input type="hidden" name="activo" value="@(!rol.Activo)" />
                                        <input type="hidden" name="empresaId" value="@Model.EmpresaId" />
                                        <button type="submit"
                                                class="btn btn-sm @(rol.Activo ? "btn-outline-danger" : "btn-outline-success")">
                                            @(rol.Activo ? "Desactivar" : "Activar")
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                        @if (!Model.Roles.Any())
                        {
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="fas fa-user-tag fa-2x mb-2 d-block"></i>
                                    No hay roles definidos para esta empresa.<br>
                                    <small>Usa el botón <strong>Nuevo Rol</strong> para crear el primero.</small>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else if (Model.Empresas.Any())
    {
        <div class="text-center py-5 text-muted">
            <i class="fas fa-arrow-up fa-2x mb-3 d-block"></i>
            Selecciona una empresa para ver y gestionar sus roles.
        </div>
    }

</div>

@if (Model.EmpresaSeleccionada != null)
{
    <!-- Modal Nuevo Rol -->
    <div class="modal fade" id="modalNuevoRol" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <form method="post" asp-page-handler="Crear">
                    <input type="hidden" name="empresaId" value="@Model.EmpresaId" />
                    <div class="modal-header bg-success text-white">
                        <h5 class="modal-title"><i class="fas fa-plus me-2"></i>Nuevo Rol</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body p-4">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Nombre del rol <span class="text-danger">*</span></label>
                            <input type="text" name="nombre" class="form-control" required maxlength="50"
                                   placeholder="Ej: Conductor, Supervisor, Jefe de Flota..." />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Descripción</label>
                            <input type="text" name="descripcion" class="form-control" maxlength="200"
                                   placeholder="Descripción opcional del rol..." />
                        </div>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" name="esAdmin" id="chkNuevoEsAdmin" />
                            <label class="form-check-label" for="chkNuevoEsAdmin">
                                Administrador de empresa
                                <small class="text-muted d-block">Acceso completo a todos los módulos contratados</small>
                            </label>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-success">
                            <i class="fas fa-save me-1"></i>Crear Rol
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Modal Editar Rol -->
    <div class="modal fade" id="modalEditarRol" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow">
                <form method="post" asp-page-handler="Editar">
                    <input type="hidden" name="rolId" id="editRolId" />
                    <input type="hidden" name="empresaId" value="@Model.EmpresaId" />
                    <div class="modal-header bg-primary text-white">
                        <h5 class="modal-title"><i class="fas fa-edit me-2"></i>Editar Rol</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body p-4">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Nombre del rol <span class="text-danger">*</span></label>
                            <input type="text" name="nombre" id="editNombre" class="form-control" required maxlength="50" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Descripción</label>
                            <input type="text" name="descripcion" id="editDescripcion" class="form-control" maxlength="200" />
                        </div>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" name="esAdmin" id="editEsAdmin" />
                            <label class="form-check-label" for="editEsAdmin">
                                Administrador de empresa
                                <small class="text-muted d-block">Acceso completo a todos los módulos contratados</small>
                            </label>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save me-1"></i>Guardar Cambios
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        document.getElementById('modalEditarRol')?.addEventListener('show.bs.modal', function (e) {
            const btn = e.relatedTarget;
            document.getElementById('editRolId').value       = btn.dataset.rolid;
            document.getElementById('editNombre').value      = btn.dataset.nombre;
            document.getElementById('editDescripcion').value = btn.dataset.descripcion ?? '';
            document.getElementById('editEsAdmin').checked   = btn.dataset.esadmin === 'true';
        });
    </script>
}
