@page
@model SeleccionarContextoModel
@{
    ViewData["Title"] = "Elegir dónde trabajar";
    ViewData["Subtitulo"] = Model.EsCambio ? "Cambiar de sitio" : "¿Dónde vas a trabajar?";
    Layout = "_LayoutEntrada";
}

<form method="post" class="login-form">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="list-group mb-3">
        @foreach (var c in Model.Contextos)
        {
            <button type="submit" name="Clave" value="@c.Clave" class="list-group-item list-group-item-action">
                @if (c.EsPlataforma)
                {
                    <div class="fw-bold"><i class="fas fa-user-shield me-2"></i>Plataforma</div>
                    <div class="small text-muted">Operador de eGestion360: trabajas con el tenant que elijas en Soporte</div>
                }
                else
                {
                    <div class="fw-bold"><i class="fas fa-building me-2"></i>@c.NombreEmpresa</div>
                    <div class="small text-muted">@c.NombreTenant (@c.CodigoTenant) · @(c.NombreRol ?? (c.RolLegado == "empresa_admin" ? "Administrador de empresa" : "Usuario"))</div>
                }
            </button>
        }
    </div>

    <div class="d-flex gap-2">
        <a href="@(Model.EsCambio ? "/MainMenu" : "/Logout")" class="btn btn-danger btn-home" title="Cancelar"><i class="fas fa-times"></i></a>
    </div>
</form>
