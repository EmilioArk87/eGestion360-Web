<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>22ddd183-f25e-4b37-b821-3e14c003af58</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- El proyecto de pruebas vive dentro de esta carpeta: no debe compilarse ni publicarse con el sitio. -->
    <Compile Remove="eGestion360Web.Tests\**" />
    <Content Remove="eGestion360Web.Tests\**" />
    <EmbeddedResource Remove="eGestion360Web.Tests\**" />
    <None Remove="eGestion360Web.Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.1.0" />
    <PackageReference Include="ClosedXML" Version="0.102.2" />
    <PackageReference Include="MailKit" Version="4.16.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- ClosedXML 0.102.2 trae System.IO.Packaging 6.0.0 (vía DocumentFormat.OpenXml), vulnerable a CVE-2024-43483 y
         CVE-2024-43484. Se fija una versión corregida hasta actualizar ClosedXML. -->
    <PackageReference Include="System.IO.Packaging" Version="10.0.12" />
  </ItemGroup>

</Project>
